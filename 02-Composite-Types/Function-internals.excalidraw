		{
			"id": "zi8r8vwc",
			"type": "text",
			"x": 35,
			"y": 1157,
			"width": 944.53125,
			"height": 48.75,
			"angle": 0,
			"strokeColor": "#BE123C",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"roughness": 0,
			"opacity": 100,
			"seed": 37973,
			"version": 2,
			"versionNonce": 760972636,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772709314628,
			"link": null,
			"locked": false,
			"text": "TRAP 1  Goroutine loop capture: for i:=range xs { go func(){ use(i) }() } - all see last i! Fix: go func(i int){ use(i) }(i)\nTRAP 2  Closure modifies shared variable without sync: concurrent goroutines writing same var -> data race!\nTRAP 3  Goroutine leak: goroutine blocked on channel nobody writes to -> leaked goroutine holds stack + funcval forever",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "TRAP 1  Goroutine loop capture: for i:=range xs { go func(){ use(i) }() } - all see last i! Fix: go func(i int){ use(i) }(i)\nTRAP 2  Closure modifies shared variable without sync: concurrent goroutines writing same var -> data race!\nTRAP 3  Goroutine leak: goroutine blocked on channel nobody writes to -> leaked goroutine holds stack + funcval forever",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "b0c",
			"strokeStyle": "solid",
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "fpvv8cdu",

		},
		{
			"id": "fm862mz4",
			"type": "text",
			"x": 35,
			"y": 1253,
			"width": 891.2109375,
			"height": 48.75,
			"angle": 0,
			"strokeColor": "#7E22CE",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"roughness": 0,
			"opacity": 100,
			"seed": 81202,
			"version": 2,
			"versionNonce": 1257929180,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772709314628,
			"link": null,
			"locked": false,
			"text": "MENTAL MODEL: Closure = function + backpack (captured vars on heap). Goroutine = lightweight thread with 2KB notepad.\n   Start 10K goroutines: ~20MB stack total (vs 10GB for 10K OS threads!). M:N scheduler multiplexes onto cores.\nESCAPE: go build -gcflags=-m shows what escapes  |  goroutine leak: goleak.VerifyNone(t) in tests",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "MENTAL MODEL: Closure = function + backpack (captured vars on heap). Goroutine = lightweight thread with 2KB notepad.\n   Start 10K goroutines: ~20MB stack total (vs 10GB for 10K OS threads!). M:N scheduler multiplexes onto cores.\nESCAPE: go build -gcflags=-m shows what escapes  |  goroutine leak: goleak.VerifyNone(t) in tests",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "b0e",
			"strokeStyle": "solid",
			"groupIds": [],
			"frameId": null,

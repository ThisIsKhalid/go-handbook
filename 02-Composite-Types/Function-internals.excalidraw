			"isDeleted": false,
			"boundElements": [],
			"updated": 1772709314628,
			"link": null,
			"locked": false,
			"text": "    return func(x int) int {\n        return x + n  // n captured - must outlive makeAdder() stack frame!\n    }  // n ESCAPES to heap via funcval struct\n}  // makeAdder returns -> its stack frame is freed -> n would be gone if on stack!",
			"fontSize": 12,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "    return func(x int) int {\n        return x + n  // n captured - must outlive makeAdder() stack frame!\n    }  // n ESCAPES to heap via funcval struct\n}  // makeAdder returns -> its stack frame is freed -> n would be gone if on stack!",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "ar",

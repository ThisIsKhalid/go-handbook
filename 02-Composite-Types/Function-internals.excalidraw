			"updated": 1772709314628,
			"link": null,
			"locked": false,
			"text": "func add(a, b int) int { return a + b }  // Go 1.17+: args in registers AX,BX; ret in AX\nadder := func(x int) int { return x+n }  // closure: n escapes to heap via funcval struct\ngo f()  // goroutine: runtime.newproc(size, fn) -> G struct + 2KB initial stack",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "func add(a, b int) int { return a + b }  // Go 1.17+: args in registers AX,BX; ret in AX\nadder := func(x int) int { return x+n }  // closure: n escapes to heap via funcval struct\ngo f()  // goroutine: runtime.newproc(size, fn) -> G struct + 2KB initial stack",

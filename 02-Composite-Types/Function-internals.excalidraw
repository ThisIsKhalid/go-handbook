			"text": "func makeAdder(n int) func(int) int {",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "func makeAdder(n int) func(int) int {",

		},
		{
			"id": "qoyoWOJS",
			"type": "text",
			"x": 97.66088492899507,
			"y": 1260.529753279717,
			"width": 601.7578125,
			"height": 81.25,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"roughness": 0,
			"opacity": 100,
			"seed": 2050,
			"version": 43,
			"versionNonce": 1465624558,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772991439454,
			"link": null,
			"locked": false,
			"text": "  Growth trigger A: load factor > 6.5 → double the buckets (B++)\n  Growth trigger B: too many overflow buckets → same-size rehash (B stays same)\n  Evacuation: INCREMENTAL — 1-2 old buckets per write, amortized O(1)\n  During growth: reads check both old and new buckets\n  Maps NEVER shrink — replace with new map if memory is a concern",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "  Growth trigger A: load factor > 6.5 → double the buckets (B++)\n  Growth trigger B: too many overflow buckets → same-size rehash (B stays same)\n  Evacuation: INCREMENTAL — 1-2 old buckets per write, amortized O(1)\n  During growth: reads check both old and new buckets\n  Maps NEVER shrink — replace with new map if memory is a concern",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "an",
			"strokeStyle": "solid",
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"hasTextLink": false,
			"rawText": ""
		},

			"updated": 1772989969937,
			"link": null,
			"locked": false,
			"text": "⑤ WHY INCREMENTAL? — THE DESIGN CHOICE",
			"fontSize": 18,
			"fontFamily": 3,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "⑤ WHY INCREMENTAL? — THE DESIGN CHOICE",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "ag",
			"strokeStyle": "solid",
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "r_why",
			"type": "rectangle",
			"x": 60,
			"y": 1020,
			"width": 1060,
			"height": 100,
			"angle": 0,
			"strokeColor": "#7048e8",
			"backgroundColor": "#f3d9fa",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"roughness": 0,
			"opacity": 100,
			"seed": 2044,
			"version": 2,
			"versionNonce": 1608818034,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772989969937,
			"link": null,
			"locked": false,
			"roundness": {
				"type": 3
			},
			"index": "ah",
			"strokeStyle": "solid",
			"groupIds": [],
			"frameId": null,
			"hasTextLink": false
		},
		{
			"id": "t_why",
			"type": "text",
			"x": 80,
			"y": 1030,
			"width": 723.6328125,
			"height": 81.25,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"roughness": 0,
			"opacity": 100,
			"seed": 2045,
			"version": 2,
			"versionNonce": 1951640238,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772989969937,
			"link": null,
			"locked": false,
			"text": "ALTERNATIVE (bad): evacuate ALL at once on first write after trigger\n  → One write could take O(n) time to move 1,000,000 entries — unacceptable latency spike\n\nGO'S CHOICE: spread evacuation across all writes (amortized O(1) per write)\n  → Each write does a little cleanup. No single write pays the full cost. Latency stays smooth.",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "ALTERNATIVE (bad): evacuate ALL at once on first write after trigger\n  → One write could take O(n) time to move 1,000,000 entries — unacceptable latency spike\n\nGO'S CHOICE: spread evacuation across all writes (amortized O(1) per write)\n  → Each write does a little cleanup. No single write pays the full cost. Latency stays smooth.",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "ai",
			"strokeStyle": "solid",
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "r_trap",
			"type": "rectangle",
			"x": 60,
			"y": 1138,
			"width": 1060,
			"height": 80,
			"angle": 0,
			"strokeColor": "#c92a2a",

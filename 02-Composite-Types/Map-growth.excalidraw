			"versionNonce": 1635247026,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772989969937,
			"link": null,
			"locked": false,
			"text": "New 4-bucket array (B=2)\n[bucket[0]: entries where hash&3==0]\n[bucket[1]: entries where hash&3==1]\n[bucket[2]: entries where hash&3==2]\n[bucket[3]: entries where hash&3==3]\nEvenly distributed — fewer overflow chains!",
			"fontSize": 14,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "New 4-bucket array (B=2)\n[bucket[0]: entries where hash&3==0]\n[bucket[1]: entries where hash&3==1]\n[bucket[2]: entries where hash&3==2]\n[bucket[3]: entries where hash&3==3]\nEvenly distributed — fewer overflow chains!",
			"lineHeight": 1.25,
			"autoResize": true,

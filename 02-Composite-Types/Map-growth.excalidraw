			"boundElements": [],
			"updated": 1772989969937,
			"link": null,
			"locked": false,
			"text": "hmap (after growth)\nB = 2\nbuckets ●──→ [new 4-bucket array]\noldbuckets = nil\n  (GC reclaims old memory)\nnevacuate = 0 (reset)",
			"fontSize": 14,
			"fontFamily": 3,
			"textAlign": "left",

		},
		{
			"id": "t_trap",
			"type": "text",
			"x": 80,
			"y": 1148,
			"width": 716.22509765625,
			"height": 48.75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"roughness": 0,
			"opacity": 100,
			"seed": 2047,
			"version": 2,
			"versionNonce": 640034030,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772989969937,
			"link": null,
			"locked": false,
			"text": "⚠ TRAP: Maps NEVER shrink — even after deleting all entries, the bucket array stays allocated.\nIf your map grew to hold 1M keys and you deleted all of them, the memory is still held.\nFix: replace the map with a new one:  m = make(map[K]V)  or let the old one be GC'd.",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "⚠ TRAP: Maps NEVER shrink — even after deleting all entries, the bucket array stays allocated.\nIf your map grew to hold 1M keys and you deleted all of them, the memory is still held.\nFix: replace the map with a new one:  m = make(map[K]V)  or let the old one be GC'd.",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "ak",
			"strokeStyle": "solid",
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"hasTextLink": false,
			"rawText": ""
		},

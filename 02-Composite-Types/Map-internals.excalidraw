      "versionNonce": 72674,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "m := make(map[string]int, 100)  // hmap + initial bucket array on heap\nm[\"alice\"] = 95                 // runtime.mapassign(t, h, key) -> slot ptr\nv, ok := m[\"alice\"]             // runtime.mapaccess2(t, h, key) -> (val, bool)\n// map is NOT safe for concurrent read+write -> use sync.RWMutex or sync.Map!",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "m := make(map[string]int, 100)  // hmap + initial bucket array on heap\nm[\"alice\"] = 95                 // runtime.mapassign(t, h, key) -> slot ptr\nv, ok := m[\"alice\"]             // runtime.mapaccess2(t, h, key) -> (val, bool)\n// map is NOT safe for concurrent read+write -> use sync.RWMutex or sync.Map!",
      "lineHeight": 1.25
    },

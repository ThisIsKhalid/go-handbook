      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 73123,
      "version": 1,
      "versionNonce": 40762,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "TRAP 1  Map is NOT safe for concurrent use - concurrent read+write -> fatal error: concurrent map read and map write\nTRAP 2  Iteration order is RANDOMIZED intentionally (hash seed changes at make) - never rely on map iteration order\nTRAP 3  Cannot take address of map value: &m[key] is a compile error - value may move during rehash!",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "TRAP 1  Map is NOT safe for concurrent use - concurrent read+write -> fatal error: concurrent map read and map write\nTRAP 2  Iteration order is RANDOMIZED intentionally (hash seed changes at make) - never rely on map iteration order\nTRAP 3  Cannot take address of map value: &m[key] is a compile error - value may move during rehash!",
      "lineHeight": 1.25
    },

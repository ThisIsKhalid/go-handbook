      "opacity": 100,
      "seed": 63061,
      "version": 1,
      "versionNonce": 45334,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "MENTAL MODEL: Map = filing cabinet. Key hash -> drawer (bucket). 8 slots per drawer. Overflow = extra drawer chained.\nPRE-SIZE: make(map[K]V, n) -> avoids rehashing  |  comma-ok: v,ok:=m[k] to detect absent keys\nCONCURRENT: sync.Map for many reads / few writes  |  sync.RWMutex for general concurrent access",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "MENTAL MODEL: Map = filing cabinet. Key hash -> drawer (bucket). 8 slots per drawer. Overflow = extra drawer chained.\nPRE-SIZE: make(map[K]V, n) -> avoids rehashing  |  comma-ok: v,ok:=m[k] to detect absent keys\nCONCURRENT: sync.Map for many reads / few writes  |  sync.RWMutex for general concurrent access",
      "lineHeight": 1.25
    }

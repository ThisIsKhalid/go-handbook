      "link": null,
      "locked": false,
      "text": "WHY: Score (int64) needs 8-byte alignment -> addr%8==0. Active at +0 -> Score at +8 -> 7B gap. Admin at +16 -> struct size=24 (next multiple of 8).",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "WHY: Score (int64) needs 8-byte alignment -> addr%8==0. Active at +0 -> Score at +8 -> 7B gap. Admin at +16 -> struct size=24 (next multiple of 8).",
      "lineHeight": 1.25
    },

    {
      "id": "2xojicwy",
      "type": "text",
      "x": 35,
      "y": 1091,
      "width": 1570,
      "height": 64,
      "angle": 0,
      "strokeColor": "#BE123C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 67044,
      "version": 1,
      "versionNonce": 65712,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "TRAP 1  Copying struct with sync.Mutex copies lock state -> race condition! go vet detects this.\nTRAP 2  Interface boxing: var i any = BigStruct{} copies entire struct to heap. Use *BigStruct.\nTRAP 3  Struct tags silently ignored if mistyped: json:\"Name\" vs json:\"name\" - no compile error!",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "TRAP 1  Copying struct with sync.Mutex copies lock state -> race condition! go vet detects this.\nTRAP 2  Interface boxing: var i any = BigStruct{} copies entire struct to heap. Use *BigStruct.\nTRAP 3  Struct tags silently ignored if mistyped: json:\"Name\" vs json:\"name\" - no compile error!",
      "lineHeight": 1.25
    },
    {

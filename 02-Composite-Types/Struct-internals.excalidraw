      "opacity": 100,
      "seed": 48781,
      "version": 1,
      "versionNonce": 51271,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "type Bad  struct { Active bool; Score int64; Admin bool }  // 24 bytes - 14 bytes WASTED!\ntype Good struct { Score int64; Active bool; Admin bool }  // 16 bytes - only tail padding\n// Rule: each field starts at addr % alignof(field) == 0  (CPU alignment requirement)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "type Bad  struct { Active bool; Score int64; Admin bool }  // 24 bytes - 14 bytes WASTED!\ntype Good struct { Score int64; Active bool; Admin bool }  // 16 bytes - only tail padding\n// Rule: each field starts at addr % alignof(field) == 0  (CPU alignment requirement)",
      "lineHeight": 1.25
    },

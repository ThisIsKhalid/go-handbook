      "opacity": 100,
      "seed": 47134,
      "version": 1,
      "versionNonce": 24361,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "MENTAL MODEL: Struct fields are boxes on a shelf. Each box must start at its natural alignment boundary.\n   Golden rule: order fields LARGEST to SMALLEST. Bools and int8s at the end - they pack together.\nTOOL: fieldalignment linter auto-reorders fields  |  unsafe.Sizeof/Offsetof for verification",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "MENTAL MODEL: Struct fields are boxes on a shelf. Each box must start at its natural alignment boundary.\n   Golden rule: order fields LARGEST to SMALLEST. Bools and int8s at the end - they pack together.\nTOOL: fieldalignment linter auto-reorders fields  |  unsafe.Sizeof/Offsetof for verification",
      "lineHeight": 1.25
    }
  ],

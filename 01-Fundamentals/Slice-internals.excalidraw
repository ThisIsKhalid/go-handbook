			"isDeleted": false,
			"boundElements": [],
			"updated": 1772386351225,
			"link": null,
			"locked": false,
			"text": "append(s, 99)  where s={Len:5, Cap:5}\n  1. call runtime.growslice(et, old, cap+1)  <- Go runtime\n  2. newCap = 10 (doubles for cap<256); mallocgc(80B)\n  3. memmove(newPtr, oldPtr, 40B); return {newPtr, Len:6, Cap:10}",
			"fontSize": 12,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "append(s, 99)  where s={Len:5, Cap:5}\n  1. call runtime.growslice(et, old, cap+1)  <- Go runtime\n  2. newCap = 10 (doubles for cap<256); mallocgc(80B)\n  3. memmove(newPtr, oldPtr, 40B); return {newPtr, Len:6, Cap:10}",
			"lineHeight": 1.25,
			"autoResize": true,

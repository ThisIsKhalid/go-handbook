			"type": "text",
			"x": 35,
			"y": 1286,
			"width": 471.09375,
			"height": 60,
			"angle": 0,
			"strokeColor": "#334155",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"roughness": 0,
			"opacity": 100,
			"seed": 34049,
			"version": 2,
			"versionNonce": 1397824228,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772386351225,
			"link": null,
			"locked": false,
			"text": "append(s, 40)  where s={Len:3, Cap:5}\n  1. s.Data[3] = 40   <- direct write to spare slot\n  2. return SliceHeader{0xc000b000, Len:4, Cap:5}  <- same pointer!\n  Assembly: MOVQ $40, 24(DX)  ; INCQ CX  (DX=ptr, CX=len)",
			"fontSize": 12,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "append(s, 40)  where s={Len:3, Cap:5}\n  1. s.Data[3] = 40   <- direct write to spare slot\n  2. return SliceHeader{0xc000b000, Len:4, Cap:5}  <- same pointer!\n  Assembly: MOVQ $40, 24(DX)  ; INCQ CX  (DX=ptr, CX=len)",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "b0d",
			"strokeStyle": "solid",
			"groupIds": [],
			"frameId": null,

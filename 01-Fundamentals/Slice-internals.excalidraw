		{
			"id": "0hvop3xi",
			"type": "text",
			"x": 34,
			"y": 142,
			"width": 738.8671875,
			"height": 65,
			"angle": 0,
			"strokeColor": "#334155",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"roughness": 0,
			"opacity": 100,
			"seed": 36619,
			"version": 2,
			"versionNonce": 1740501732,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772386351225,
			"link": null,
			"locked": false,
			"text": "s   := make([]int, 3, 5)   // SliceHeader{Data *[5]int, Len:3, Cap:5} - 3x8=24B on stack\nsub := s[1:3]              // New header pointing into s[1], SAME heap array - zero copy!\ns    = append(s, 99)       // len<cap -> fast write; len==cap -> runtime.growslice -> malloc+copy\n// runtime.makeslice(et *_type, len, cap int) unsafe.Pointer  <- actual Go runtime call",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "s   := make([]int, 3, 5)   // SliceHeader{Data *[5]int, Len:3, Cap:5} - 3x8=24B on stack\nsub := s[1:3]              // New header pointing into s[1], SAME heap array - zero copy!\ns    = append(s, 99)       // len<cap -> fast write; len==cap -> runtime.growslice -> malloc+copy\n// runtime.makeslice(et *_type, len, cap int) unsafe.Pointer  <- actual Go runtime call",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "a5",
			"strokeStyle": "solid",
			"groupIds": [],

			"isDeleted": false,
			"boundElements": [],
			"updated": 1772386351225,
			"link": null,
			"locked": false,
			"text": "TRAP 1  b:=a[:3]; append(b,x) silently overwrites a[3]!  Fix: b:=a[:3:3] (3-index forces cap=len=3)\nTRAP 2  json.Marshal(nil slice)->\"null\"  vs json.Marshal([]int{})->\"[]\"  - different wire format!\nTRAP 3  Small sub-slice keeps ENTIRE large backing array in GC roots -> memory leak! Fix: copy to new slice",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "TRAP 1  b:=a[:3]; append(b,x) silently overwrites a[3]!  Fix: b:=a[:3:3] (3-index forces cap=len=3)\nTRAP 2  json.Marshal(nil slice)->\"null\"  vs json.Marshal([]int{})->\"[]\"  - different wire format!\nTRAP 3  Small sub-slice keeps ENTIRE large backing array in GC roots -> memory leak! Fix: copy to new slice",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "b17",
			"strokeStyle": "solid",
			"groupIds": [],
			"frameId": null,
			"roundness": null,

			"text": "FAST PATH  -  len < cap  (no allocation, O(1))",
			"fontSize": 15,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "FAST PATH  -  len < cap  (no allocation, O(1))",

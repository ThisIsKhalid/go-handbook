      "opacity": 100,
      "seed": 10140,
      "version": 1,
      "versionNonce": 28210,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "TRAP 1  s[i] returns a BYTE not a rune - s[0] on Japanese string gives 0xE6, not the rune!\nTRAP 2  len(s) counts BYTES not runes - use utf8.RuneCountInString(s) for true character count\nTRAP 3  String concatenation in loop: each + allocates new backing array O(n^2). Fix: strings.Builder",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "TRAP 1  s[i] returns a BYTE not a rune - s[0] on Japanese string gives 0xE6, not the rune!\nTRAP 2  len(s) counts BYTES not runes - use utf8.RuneCountInString(s) for true character count\nTRAP 3  String concatenation in loop: each + allocates new backing array O(n^2). Fix: strings.Builder",
      "lineHeight": 1.25
    },

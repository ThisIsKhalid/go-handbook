    {
      "id": "98432agn",
      "type": "text",
      "x": 34,
      "y": 142,
      "width": 1572,
      "height": 74,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 28555,
      "version": 1,
      "versionNonce": 42225,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "s := \"Hello\"          // StringHeader{Ptr *byte, Len 5} - 16 bytes on stack\nb := []byte(s)        // COPY: mallocgc(5), memmove 5 bytes -> O(n) allocation!\nr := []rune(s)        // COPY: UTF-8 decode -> []int32, variable width per rune\n// runtime.stringtoslicebyte(buf *[32]byte, s string) []byte  <- may use stack buf!",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "s := \"Hello\"          // StringHeader{Ptr *byte, Len 5} - 16 bytes on stack\nb := []byte(s)        // COPY: mallocgc(5), memmove 5 bytes -> O(n) allocation!\nr := []rune(s)        // COPY: UTF-8 decode -> []int32, variable width per rune\n// runtime.stringtoslicebyte(buf *[32]byte, s string) []byte  <- may use stack buf!",
      "lineHeight": 1.25
    },

		{
			"id": "XKVisgqG",
			"type": "text",
			"x": 679.0019179165988,
			"y": 563.7222670607009,
			"width": 477.6484375,
			"height": 97.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"roughness": 0,

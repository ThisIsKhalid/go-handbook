			"seed": 1128,
			"version": 114,
			"versionNonce": 105704548,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772385124921,
			"link": null,
			"locked": false,
			"text": "Step ①: Check: is Len(5) == Cap(5)?  YES → must grow\nStep ②: Calculate new cap:  cap(5) < 256 → newCap = 5 × 2 = 10\nStep ③: Allocate NEW array of 10 ints on heap  (80 bytes)\nStep ④: Copy old 5 elements to new array\nStep ⑤: Write new value (6) into new array position [5]\nStep ⑥: Update header: new Data ptr → new array, Len=6, Cap=10",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "Step ①: Check: is Len(5) == Cap(5)?  YES → must grow\nStep ②: Calculate new cap:  cap(5) < 256 → newCap = 5 × 2 = 10\nStep ③: Allocate NEW array of 10 ints on heap  (80 bytes)\nStep ④: Copy old 5 elements to new array\nStep ⑤: Write new value (6) into new array position [5]\nStep ⑥: Update header: new Data ptr → new array, Len=6, Cap=10",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "aR",
			"strokeStyle": "solid",
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"hasTextLink": false,
			"rawText": ""
		},

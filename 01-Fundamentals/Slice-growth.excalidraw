			"isDeleted": false,
			"boundElements": [],
			"updated": 1772385109100,
			"link": null,
			"locked": false,
			"text": "Step ①: Check: is Len(3) < Cap(5)?  YES → fast path!\nStep ②: Write new value 4 directly into buf[sendx=3]: [3] becomes 4 (green)\nStep ③: Increment Len from 3 → 4\nResult: SAME backing array, SAME header, just Len changed.  Cost: O(1), ZERO allocation, ZERO GC pressure",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "Step ①: Check: is Len(3) < Cap(5)?  YES → fast path!\nStep ②: Write new value 4 directly into buf[sendx=3]: [3] becomes 4 (green)\nStep ③: Increment Len from 3 → 4\nResult: SAME backing array, SAME header, just Len changed.  Cost: O(1), ZERO allocation, ZERO GC pressure",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "aJ",
			"strokeStyle": "solid",
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"hasTextLink": false,
			"rawText": ""
		},

			"isDeleted": false,
			"boundElements": [],
			"updated": 1771872539499,
			"link": null,
			"locked": false,
			"text": "var a [5]int           // 5x8=40 bytes contiguous; [5]int and [4]int are DIFFERENT types\nb := a                 // FULL COPY: 40 bytes copied on stack - not a reference!\nf(a)                   // COPIES 40 bytes into callee stack frame - expensive for large arrays!\n// MOVQ  $0, (SP)     ; MOVQ  $0, 8(SP)  ... repeat 5 times  (compiler zero-inits)",
			"fontSize": 13,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "var a [5]int           // 5x8=40 bytes contiguous; [5]int and [4]int are DIFFERENT types\nb := a                 // FULL COPY: 40 bytes copied on stack - not a reference!\nf(a)                   // COPIES 40 bytes into callee stack frame - expensive for large arrays!\n// MOVQ  $0, (SP)     ; MOVQ  $0, 8(SP)  ... repeat 5 times  (compiler zero-inits)",
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "a5",
			"strokeStyle": "solid",
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"hasTextLink": false,
			"rawText": ""

      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "var p *int        // p == nil  (zero value: 0x0000000000000000)\nfmt.Println(*p)   // PANIC: runtime error: invalid memory address or nil pointer dereference\nFix: always check  if p != nil { *p }  or use value semantics",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "var p *int        // p == nil  (zero value: 0x0000000000000000)\nfmt.Println(*p)   // PANIC: runtime error: invalid memory address or nil pointer dereference\nFix: always check  if p != nil { *p }  or use value semantics",
      "lineHeight": 1.25
    },

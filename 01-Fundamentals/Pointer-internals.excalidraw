      "versionNonce": 83557,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "TESTQ AX, AX         ; nil check: if AX==0 then CALL runtime.panicNilPointerDereference",
      "fontSize": 12,

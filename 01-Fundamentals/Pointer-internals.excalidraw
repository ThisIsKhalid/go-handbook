    {
      "id": "e0ua344e",
      "type": "text",
      "x": 34,
      "y": 142,
      "width": 1572,
      "height": 74,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 29348,
      "version": 1,
      "versionNonce": 92642,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "x  := 42          // x lives on stack at some addr, say 0xc000e008\np  := &x          // p = 8-byte pointer holding address 0xc000e008\n*p  = 100         // dereference: writes 100 to x's memory location\n// LEAQ x(SP), AX  ; MOVQ AX, p+0(SP)   <- &x in assembly",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "x  := 42          // x lives on stack at some addr, say 0xc000e008\np  := &x          // p = 8-byte pointer holding address 0xc000e008\n*p  = 100         // dereference: writes 100 to x's memory location\n// LEAQ x(SP), AX  ; MOVQ AX, p+0(SP)   <- &x in assembly",
      "lineHeight": 1.25
    },

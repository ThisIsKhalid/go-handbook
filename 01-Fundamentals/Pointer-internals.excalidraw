      "versionNonce": 44659,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ASSEMBLY: pointer dereference  *p  ->  indirect memory access via register:",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "ASSEMBLY: pointer dereference  *p  ->  indirect memory access via register:",
      "lineHeight": 1.25
    },
    {
      "id": "2vukmdm6",
      "type": "text",
      "x": 34,
      "y": 940,
      "width": 1572,
      "height": 18,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 85627,
      "version": 1,
      "versionNonce": 34149,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "MOVQ  p+0(SP), AX    ; load pointer value (address) into AX  (AX = 0xc000e008)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "MOVQ  p+0(SP), AX    ; load pointer value (address) into AX  (AX = 0xc000e008)",
      "lineHeight": 1.25
    },
    {
      "id": "s57ueedu",
      "type": "text",
      "x": 34,
      "y": 960,
      "width": 1572,
      "height": 18,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 24399,
      "version": 1,
      "versionNonce": 93334,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "MOVQ  (AX), BX       ; dereference: load value AT address in AX into BX  (BX = 42)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "MOVQ  (AX), BX       ; dereference: load value AT address in AX into BX  (BX = 42)",
      "lineHeight": 1.25
    },
    {
      "id": "oe7sgl6r",
      "type": "text",
      "x": 34,
      "y": 980,
      "width": 1572,
      "height": 18,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 19115,
      "version": 1,
      "versionNonce": 34952,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "MOVQ  $100, (AX)     ; *p = 100  -- store 100 at the address held in AX",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "MOVQ  $100, (AX)     ; *p = 100  -- store 100 at the address held in AX",
      "lineHeight": 1.25
    },
    {

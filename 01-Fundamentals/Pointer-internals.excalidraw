      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "&x takes address of x (8 bytes on 64-bit).  *p dereferences.  All pointer types are the same size.",
      "lineHeight": 1.25

      "updated": 1,
      "link": null,
      "locked": false,
      "text": "func double(p *int) { *p *= 2 }  // dereference and write through\ndouble(&x)  // x is now 84 - mutation visible in caller!\nAssembly: MOVQ (AX), BX ; SHLQ $1, BX ; MOVQ BX, (AX)  (AX holds &x)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",

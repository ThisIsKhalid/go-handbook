      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "roundness": {
        "type": 3
      }
    },
    {
      "id": "6onvt1dr",
      "type": "text",
      "x": 35,
      "y": 1278,
      "width": 1570,
      "height": 64,
      "angle": 0,
      "strokeColor": "#BE123C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 30651,
      "version": 1,
      "versionNonce": 73616,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "TRAP 1  (*T)(nil) assigned to interface != nil interface. Check concrete pointer, not interface value.\nTRAP 2  Interface boxing copies values to heap -> allocations in hot path. Use concrete types for perf.\nTRAP 3  Two interfaces equal only if BOTH type AND value are equal. nil interface != interface((*T)(nil))!",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "TRAP 1  (*T)(nil) assigned to interface != nil interface. Check concrete pointer, not interface value.\nTRAP 2  Interface boxing copies values to heap -> allocations in hot path. Use concrete types for perf.\nTRAP 3  Two interfaces equal only if BOTH type AND value are equal. nil interface != interface((*T)(nil))!",
      "lineHeight": 1.25
    },
    {
      "id": "7u5ucflw",
      "type": "rectangle",
      "x": 20,
      "y": 1364,
      "width": 1600,
      "height": 84,
      "angle": 0,
      "strokeColor": "#7E22CE",
      "backgroundColor": "#FAF5FF",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 99602,
      "version": 1,
      "versionNonce": 75696,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "roundness": {
        "type": 3
      }
    },
    {
      "id": "w0aeya4r",
      "type": "text",
      "x": 35,
      "y": 1374,
      "width": 1570,
      "height": 64,
      "angle": 0,
      "strokeColor": "#7E22CE",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 90614,
      "version": 1,
      "versionNonce": 10796,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "MENTAL MODEL: Interface = two-slot envelope. Slot 1 = type tag (itab). Slot 2 = data pointer.\n   Empty envelope (both nil) != envelope with empty letter (itab set, data nil).\nPERF: avoid interface in hot loops - use generics (Go 1.18+) or concrete types for zero-overhead dispatch",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "MENTAL MODEL: Interface = two-slot envelope. Slot 1 = type tag (itab). Slot 2 = data pointer.\n   Empty envelope (both nil) != envelope with empty letter (itab set, data nil).\nPERF: avoid interface in hot loops - use generics (Go 1.18+) or concrete types for zero-overhead dispatch",
      "lineHeight": 1.25
    }
  ],

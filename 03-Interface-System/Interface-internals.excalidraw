      "locked": false,
      "text": "var a any = 42  -  scalar boxing",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "var a any = 42  -  scalar boxing",
      "lineHeight": 1.25
    },
    {
      "id": "2rh1y0vg",
      "type": "text",
      "x": 35,
      "y": 716,
      "width": 700,
      "height": 138,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 31672,
      "version": 1,
      "versionNonce": 78971,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "eface{\n  _type: *rtype for int  (static ptr in binary, always same)\n  data:  8B scalar fits in pointer word -> stored directly!\n         (if size <= pointer size AND no pointers -> no heap alloc)\n}\nvar b any = 42  ->  b._type == a._type (same static *rtype)\na == b  // true: compare _type pointer then value",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "eface{\n  _type: *rtype for int  (static ptr in binary, always same)\n  data:  8B scalar fits in pointer word -> stored directly!\n         (if size <= pointer size AND no pointers -> no heap alloc)\n}\nvar b any = 42  ->  b._type == a._type (same static *rtype)\na == b  // true: compare _type pointer then value",
      "lineHeight": 1.25
    },

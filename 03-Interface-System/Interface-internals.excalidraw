      "versionNonce": 39476,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ASSEMBLY: interface method call  w.Write(p)  via itab function pointer:",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "ASSEMBLY: interface method call  w.Write(p)  via itab function pointer:",
      "lineHeight": 1.25
    },
    {
      "id": "ysgrpizq",
      "type": "text",
      "x": 34,
      "y": 1144,
      "width": 1572,
      "height": 18,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 74783,
      "version": 1,
      "versionNonce": 59675,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "MOVQ  w.itab(SP), AX         ; load itab pointer (check != nil first)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "MOVQ  w.itab(SP), AX         ; load itab pointer (check != nil first)",
      "lineHeight": 1.25
    },
    {
      "id": "og6r54eh",
      "type": "text",
      "x": 34,
      "y": 1164,
      "width": 1572,
      "height": 18,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 37951,
      "version": 1,
      "versionNonce": 40964,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "MOVQ  w.data(SP), DX         ; load data pointer (receiver)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "MOVQ  w.data(SP), DX         ; load data pointer (receiver)",
      "lineHeight": 1.25
    },
    {
      "id": "gisskila",
      "type": "text",
      "x": 34,
      "y": 1184,
      "width": 1572,
      "height": 18,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 82252,
      "version": 1,
      "versionNonce": 10003,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "MOVQ  itab.fun[0](AX), CX    ; load Write method pointer from itab.fun[0]",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "MOVQ  itab.fun[0](AX), CX    ; load Write method pointer from itab.fun[0]",
      "lineHeight": 1.25
    },
    {
      "id": "3762j8cn",
      "type": "text",
      "x": 34,
      "y": 1204,
      "width": 1572,
      "height": 18,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 32622,
      "version": 1,
      "versionNonce": 62081,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "MOVQ  DX, AX                 ; move receiver to AX (first arg = self)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "MOVQ  DX, AX                 ; move receiver to AX (first arg = self)",
      "lineHeight": 1.25
    },
    {
      "id": "ubrdx32y",
      "type": "text",
      "x": 34,
      "y": 1224,
      "width": 1572,
      "height": 18,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 35941,
      "version": 1,
      "versionNonce": 86583,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "CALL  CX                     ; indirect call through function pointer (not inlinable!)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "CALL  CX                     ; indirect call through function pointer (not inlinable!)",
      "lineHeight": 1.25
    },
    {
      "id": "u6qzkxzd",

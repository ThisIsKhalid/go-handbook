    {
      "id": "zchokhr0",
      "type": "text",
      "x": 34,
      "y": 142,
      "width": 1572,
      "height": 74,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 88467,
      "version": 1,
      "versionNonce": 10115,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "var w io.Writer = os.Stdout  // iface{itab: *itab, data: *os.File} on stack - 16 bytes\nvar a any = 42               // eface{_type: *rtype, data: *int} - boxing allocates!\nvar w io.Writer              // nil iface: BOTH itab==nil AND data==nil\nvar p *os.File = nil; var w io.Writer = p  // TRAP: w != nil! itab is set!",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "var w io.Writer = os.Stdout  // iface{itab: *itab, data: *os.File} on stack - 16 bytes\nvar a any = 42               // eface{_type: *rtype, data: *int} - boxing allocates!\nvar w io.Writer              // nil iface: BOTH itab==nil AND data==nil\nvar p *os.File = nil; var w io.Writer = p  // TRAP: w != nil! itab is set!",
      "lineHeight": 1.25
    },

      "version": 1,
      "versionNonce": 53326,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "iface{\n  itab: *itab for (*os.File, io.Writer)  <- NOT nil!\n  data: nil  (the concrete *os.File is nil)\n}\nw == nil  // FALSE! itab != nil -> interface is NOT nil!\n// Fix: check  w.(*os.File) == nil  (type assert then nil check)\n// Or:  reflect.ValueOf(w).IsNil()",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",

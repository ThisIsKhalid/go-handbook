      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "③ Write barrier: protects GC during Phase 2 — if goroutine creates BLACK→WHITE pointer, barrier marks WHITE as GREY:",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "③ Write barrier: protects GC during Phase 2 — if goroutine creates BLACK→WHITE pointer, barrier marks WHITE as GREY:",
      "lineHeight": 1.25
    },

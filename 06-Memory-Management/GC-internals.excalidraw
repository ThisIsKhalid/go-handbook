      "updated": 1,
      "link": null,
      "locked": false,
      "text": "PHASE 3\nMark Term\n(STW ~100μs)\n─────────────\nStop goroutines\nFlush remaining grey\nDisable write barrier\nWhite = garbage\nResume goroutines",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PHASE 3\nMark Term\n(STW ~100μs)\n─────────────\nStop goroutines\nFlush remaining grey\nDisable write barrier\nWhite = garbage\nResume goroutines",
      "lineHeight": 1.25
    },

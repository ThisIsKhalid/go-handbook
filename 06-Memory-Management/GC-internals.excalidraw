      "opacity": 100,
      "seed": 2440,
      "version": 1,
      "versionNonce": 2440,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "⚠ TRAP:  GOGC=off → disables GC entirely → heap grows unbounded → OOM in production!\n         GOGC=1  → GC runs every 1% heap growth → GC eats all CPU → app grinds to halt\n         Large long-lived objects bloat live heap → GC triggers less often → large STW pauses",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⚠ TRAP:  GOGC=off → disables GC entirely → heap grows unbounded → OOM in production!\n         GOGC=1  → GC runs every 1% heap growth → GC eats all CPU → app grinds to halt\n         Large long-lived objects bloat live heap → GC triggers less often → large STW pauses",
      "lineHeight": 1.25
    },

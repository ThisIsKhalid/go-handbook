      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "② GC runs in 4 phases — mostly concurrent with your goroutines (STW = stop-the-world, ~100μs each):",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "② GC runs in 4 phases — mostly concurrent with your goroutines (STW = stop-the-world, ~100μs each):",
      "lineHeight": 1.25
    },

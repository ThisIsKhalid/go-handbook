      "versionNonce": 25523,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "PHASE 1\nMark Start\n(STW ~100μs)\n─────────────\nStop goroutines\nScan stacks+globals\nRoots → GREY\nEnable write barrier\nResume goroutines",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PHASE 1\nMark Start\n(STW ~100μs)\n─────────────\nStop goroutines\nScan stacks+globals\nRoots → GREY\nEnable write barrier\nResume goroutines",
      "lineHeight": 1.25
    },

      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "PHASE 2\nMark\n(concurrent)\n─────────────\nGC + goroutines run\nGREY → scan ptrs\n  children → GREY\nWhen done → BLACK\nUntil no GREY left",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PHASE 2\nMark\n(concurrent)\n─────────────\nGC + goroutines run\nGREY → scan ptrs\n  children → GREY\nWhen done → BLACK\nUntil no GREY left",
      "lineHeight": 1.25
    },

    {
      "id": "gc_trap_txt",
      "type": "text",
      "x": 55,
      "y": 622,
      "width": 860,
      "height": 55,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,

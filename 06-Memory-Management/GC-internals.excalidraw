      "updated": 1,
      "link": null,
      "locked": false,
      "text": "PHASE 4\nSweep\n(concurrent)\n─────────────\nGoroutines run freely\nWhite spans → free list\nReturn to mcache\nBackground goroutine\nNext trigger calculated",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PHASE 4\nSweep\n(concurrent)\n─────────────\nGoroutines run freely\nWhite spans → free list\nReturn to mcache\nBackground goroutine\nNext trigger calculated",
      "lineHeight": 1.25
    },
    {
      "id": "gc_step3",
      "type": "text",
      "x": 40,
      "y": 518,
      "width": 880,
      "height": 22,

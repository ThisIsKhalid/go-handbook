      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "GOGC=100  (default: run GC when live heap doubles since last GC)\nruntime.GC()   // force a GC cycle right now (for benchmarks / testing)",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GOGC=100  (default: run GC when live heap doubles since last GC)\nruntime.GC()   // force a GC cycle right now (for benchmarks / testing)",
      "lineHeight": 1.25
    },

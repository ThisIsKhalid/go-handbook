    {
      "id": "54clrzjz",
      "type": "text",
      "x": 35,
      "y": 1762,
      "width": 1570,
      "height": 64,
      "angle": 0,
      "strokeColor": "#7E22CE",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,

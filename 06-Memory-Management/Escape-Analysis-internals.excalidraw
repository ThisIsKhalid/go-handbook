    {
      "id": "0gbfw9fu",
      "type": "text",
      "x": 28,
      "y": 400,
      "width": 288,
      "height": 80,
      "angle": 0,
      "strokeColor": "#BE123C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 60493,
      "version": 1,
      "versionNonce": 11617,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Returning a pointer to a local variable forces it to heap.\nThe stack frame is freed on return, so the data MUST survive on heap.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Returning a pointer to a local variable forces it to heap.\nThe stack frame is freed on return, so the data MUST survive on heap.",
      "lineHeight": 1.25
    },

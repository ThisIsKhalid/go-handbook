    {
      "id": "r8clubnj",
      "type": "text",
      "x": 34,
      "y": 148,
      "width": 1572,
      "height": 114,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 62205,
      "version": 1,
      "versionNonce": 20084,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "// See escape analysis output:\ngo build -gcflags='-m -m' ./...   // -m shows decisions, -m -m shows WHY\ngo build -gcflags='-m=2' ./...    // more detail on inlining decisions\n// Common output:\n// main.go:12:13: &x escapes to heap    <- heap alloc\n// main.go:18:10: buf does not escape    <- stays on stack (fast!)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "// See escape analysis output:\ngo build -gcflags='-m -m' ./...   // -m shows decisions, -m -m shows WHY\ngo build -gcflags='-m=2' ./...    // more detail on inlining decisions\n// Common output:\n// main.go:12:13: &x escapes to heap    <- heap alloc\n// main.go:18:10: buf does not escape    <- stays on stack (fast!)",
      "lineHeight": 1.25
    },

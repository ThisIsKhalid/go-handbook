      "seed": 13840,
      "version": 1,
      "versionNonce": 46822,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "// Compiler inlines newInt into main:\nfunc main() {\n    x := 42         // x does NOT escape!\n    p := &x         // p points to stack x\n    // ... use p locally only\n    // x lives on main's stack frame\n}",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "// Compiler inlines newInt into main:\nfunc main() {\n    x := 42         // x does NOT escape!\n    p := &x         // p points to stack x\n    // ... use p locally only\n    // x lives on main's stack frame\n}",
      "lineHeight": 1.25

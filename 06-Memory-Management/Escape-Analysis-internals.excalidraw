    {
      "id": "79o2xz36",
      "type": "text",
      "x": 656,
      "y": 400,
      "width": 288,
      "height": 80,
      "angle": 0,
      "strokeColor": "#7E22CE",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 29758,
      "version": 1,
      "versionNonce": 55215,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A variable captured by a goroutine's closure MUST be on heap.\nThe goroutine may outlive the parent function's stack frame.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "A variable captured by a goroutine's closure MUST be on heap.\nThe goroutine may outlive the parent function's stack frame.",
      "lineHeight": 1.25
    },

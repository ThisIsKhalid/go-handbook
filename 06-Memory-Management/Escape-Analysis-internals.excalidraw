      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 29424,
      "version": 1,
      "versionNonce": 84264,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "TRAP 1  fmt.Println(x) ALWAYS causes x to escape (variadic any parameter) - avoid in hot paths, use logger with typed args\nTRAP 2  Closures that capture loop variables by reference: for i:=range xs { go f(&xs[i]) } - xs[i] may escape!\nTRAP 3  interface method call on large struct: always copies struct to heap for boxing - use pointer receiver instead",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "TRAP 1  fmt.Println(x) ALWAYS causes x to escape (variadic any parameter) - avoid in hot paths, use logger with typed args\nTRAP 2  Closures that capture loop variables by reference: for i:=range xs { go f(&xs[i]) } - xs[i] may escape!\nTRAP 3  interface method call on large struct: always copies struct to heap for boxing - use pointer receiver instead",
      "lineHeight": 1.25
    },

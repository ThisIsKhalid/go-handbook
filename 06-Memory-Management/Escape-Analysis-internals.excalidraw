      "versionNonce": 61502,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Assigning a concrete value to an interface{} / any copies it\nto the heap because interface holds a pointer, not the value.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Assigning a concrete value to an interface{} / any copies it\nto the heap because interface holds a pointer, not the value.",
      "lineHeight": 1.25
    },

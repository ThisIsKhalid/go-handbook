      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "func newInt(v int) *int {\n    x := v         // x escapes to heap  <-- gcflags=-m\n    return &x\n}\nfunc main() {\n    p := newInt(42)  // heap alloc, GC tracked\n}",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "func newInt(v int) *int {\n    x := v         // x escapes to heap  <-- gcflags=-m\n    return &x\n}\nfunc main() {\n    p := newInt(42)  // heap alloc, GC tracked\n}",
      "lineHeight": 1.25
    },

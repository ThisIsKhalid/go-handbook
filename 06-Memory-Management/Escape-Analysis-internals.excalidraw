      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "func newInt(v int) *int {\n    x := v          // x ESCAPES!\n    return &x       // caller holds ptr\n}                   // x on heap",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "func newInt(v int) *int {\n    x := v          // x ESCAPES!\n    return &x       // caller holds ptr\n}                   // x on heap",
      "lineHeight": 1.25
    },

      "version": 1,
      "versionNonce": 59632,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "RESULT: Want 20B? Gets rounded up to 24B class. ALL 24B objects in same mspan. No fragmentation! Free list is perfect.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "RESULT: Want 20B? Gets rounded up to 24B class. ALL 24B objects in same mspan. No fragmentation! Free list is perfect.",
      "lineHeight": 1.25
    },

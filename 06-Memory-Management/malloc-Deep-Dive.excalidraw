      "versionNonce": 25279,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ADVANCED: The 3-Level Allocator \u2014 mcache \u2192 mcentral \u2192 mheap",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "ADVANCED: The 3-Level Allocator \u2014 mcache \u2192 mcentral \u2192 mheap",
      "lineHeight": 1.25
    },
    {
      "id": "i7yjzzs2",
      "type": "rectangle",
      "x": 40,
      "y": 1164,
      "width": 480,
      "height": 320,
      "angle": 0,
      "strokeColor": "#0E7490",
      "backgroundColor": "#ECFEFF",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "roughness": 0,
      "opacity": 100,
      "seed": 46206,
      "version": 1,
      "versionNonce": 76425,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,

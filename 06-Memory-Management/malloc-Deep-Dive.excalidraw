      "text": "CHECKING OUT (free/GC)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "CHECKING OUT (free/GC)",

    {
      "id": "k9hywb2p",
      "type": "text",
      "x": 50,
      "y": 264,
      "width": 340,
      "height": 80,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

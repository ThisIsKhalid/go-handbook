    },
    {
      "id": "lzmmec3u",
      "type": "text",
      "x": 35,
      "y": 1948,
      "width": 1670,
      "height": 48,
      "angle": 0,
      "strokeColor": "#7E22CE",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 61438,
      "version": 1,
      "versionNonce": 15147,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "KEY INSIGHT: Most allocations never touch a lock! mcache serves them lock-free (just freeindex++).\nLocks only needed when mcache miss (get new mspan) or large alloc (>32KB). Design for small frequent allocs!",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "KEY INSIGHT: Most allocations never touch a lock! mcache serves them lock-free (just freeindex++).\nLocks only needed when mcache miss (get new mspan) or large alloc (>32KB). Design for small frequent allocs!",
      "lineHeight": 1.25
    }
  ],

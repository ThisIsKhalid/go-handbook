      }
    },
    {
      "id": "5wpokutv",
      "type": "text",
      "x": 52,
      "y": 1174,
      "width": 456,
      "height": 28,
      "angle": 0,
      "strokeColor": "#0E7490",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 12411,
      "version": 1,
      "versionNonce": 87609,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "LEVEL 1: mcache",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "LEVEL 1: mcache",
      "lineHeight": 1.25
    },
    {
      "id": "rnbuiiux",
      "type": "text",
      "x": 52,
      "y": 1208,
      "width": 456,
      "height": 264,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 57852,
      "version": 1,
      "versionNonce": 43001,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Per-processor (per-P), NO LOCK NEEDED!\n\nEach logical CPU (P) has its own mcache.\nContains: one mspan per size class.\n\nHOW IT WORKS:\nalloc[sizeClass] -> mspan -> freeindex\nAllocate: buf = mspan.base + freeindex*size\n          freeindex++  (just ONE increment!)\n\nMiss: fetch new full mspan from mcentral.\n\nSpeed: lock-free bump pointer = nanoseconds!",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Per-processor (per-P), NO LOCK NEEDED!\n\nEach logical CPU (P) has its own mcache.\nContains: one mspan per size class.\n\nHOW IT WORKS:\nalloc[sizeClass] -> mspan -> freeindex\nAllocate: buf = mspan.base + freeindex*size\n          freeindex++  (just ONE increment!)\n\nMiss: fetch new full mspan from mcentral.\n\nSpeed: lock-free bump pointer = nanoseconds!",
      "lineHeight": 1.25
    },
    {
      "id": "rplnt9j3",
      "type": "rectangle",
      "x": 540,
      "y": 1164,
      "width": 480,
      "height": 320,
      "angle": 0,
      "strokeColor": "#15803D",
      "backgroundColor": "#F0FDF4",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "roughness": 0,
      "opacity": 100,
      "seed": 24367,
      "version": 1,
      "versionNonce": 52012,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "roundness": {
        "type": 3
      }
    },
    {
      "id": "37xjmvf8",
      "type": "text",
      "x": 552,
      "y": 1174,
      "width": 456,
      "height": 28,
      "angle": 0,
      "strokeColor": "#15803D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 68925,
      "version": 1,
      "versionNonce": 17450,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "LEVEL 2: mcentral",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "LEVEL 2: mcentral",
      "lineHeight": 1.25
    },
    {
      "id": "f2hlfisd",
      "type": "text",
      "x": 552,
      "y": 1208,
      "width": 456,
      "height": 264,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 53571,
      "version": 1,
      "versionNonce": 14496,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Per-size-class, shared with mutex lock.\n\nContains:\n- nonempty list: mspans with free slots\n- empty list: fully allocated mspans\n\nHOW IT WORKS:\nmcache runs out of a size class?\nLock mcentral[sizeClass].mutex\nTake head of nonempty list (full mspan)\nGive to mcache\nUnlock\n\nSpeed: mutex lock, but rare (whole mspan at once)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Per-size-class, shared with mutex lock.\n\nContains:\n- nonempty list: mspans with free slots\n- empty list: fully allocated mspans\n\nHOW IT WORKS:\nmcache runs out of a size class?\nLock mcentral[sizeClass].mutex\nTake head of nonempty list (full mspan)\nGive to mcache\nUnlock\n\nSpeed: mutex lock, but rare (whole mspan at once)",
      "lineHeight": 1.25
    },

      "versionNonce": 48413,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Go's trick: each CPU core has\nits OWN pre-reserved room block!\nNo waiting in line at the front\ndesk. Ultra fast check-in!",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Go's trick: each CPU core has\nits OWN pre-reserved room block!\nNo waiting in line at the front\ndesk. Ultra fast check-in!",
      "lineHeight": 1.25
    },

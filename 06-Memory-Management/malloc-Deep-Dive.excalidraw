    {
      "id": "9evlxjhj",
      "type": "text",
      "x": 35,
      "y": 1868,
      "width": 1670,
      "height": 48,
      "angle": 0,
      "strokeColor": "#BE123C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 49501,
      "version": 1,
      "versionNonce": 25027,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "COMMON MISTAKE: 'Go doesn't use malloc' - WRONG! Go has its own allocator (mallocgc) built on top of mmap().\nIt's smarter than C malloc: size classes, per-P cache, GC integration. But it IS allocation - avoid in hot loops!",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "COMMON MISTAKE: 'Go doesn't use malloc' - WRONG! Go has its own allocator (mallocgc) built on top of mmap().\nIt's smarter than C malloc: size classes, per-P cache, GC integration. But it IS allocation - avoid in hot loops!",
      "lineHeight": 1.25
    },
    {
      "id": "xcdxzka4",
      "type": "rectangle",
      "x": 20,
      "y": 1938,
      "width": 1700,
      "height": 68,

    },
    {
      "id": "5ap9c4jp",
      "type": "text",
      "x": 1190,
      "y": 264,
      "width": 340,
      "height": 80,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",

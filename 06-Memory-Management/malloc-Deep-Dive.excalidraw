      "version": 1,
      "versionNonce": 29606,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Your computer's RAM is like a\nhuge hotel with millions of rooms.\nEach room can hold a tiny piece\nof data (1 byte = 1 room).",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Your computer's RAM is like a\nhuge hotel with millions of rooms.\nEach room can hold a tiny piece\nof data (1 byte = 1 room).",
      "lineHeight": 1.25
    },

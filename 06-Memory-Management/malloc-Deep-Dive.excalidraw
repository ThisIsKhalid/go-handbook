    },
    {
      "id": "epkc3nvd",
      "type": "text",
      "x": 430,
      "y": 264,
      "width": 340,
      "height": 80,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 74638,
      "version": 1,
      "versionNonce": 21395,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "When your program needs memory,\nit 'checks in' to some rooms.\nThe allocator finds empty rooms\nand gives you the room numbers.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "When your program needs memory,\nit 'checks in' to some rooms.\nThe allocator finds empty rooms\nand gives you the room numbers.",
      "lineHeight": 1.25
    },

    },
    {
      "id": "lcs05noo",
      "type": "text",
      "x": 810,
      "y": 264,
      "width": 340,
      "height": 80,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 87469,
      "version": 1,
      "versionNonce": 19559,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "When you're done, rooms get freed.\nIn C: you call free() manually.\nIn Go: GC automatically checks\nwho's still using which rooms.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "When you're done, rooms get freed.\nIn C: you call free() manually.\nIn Go: GC automatically checks\nwho's still using which rooms.",
      "lineHeight": 1.25
    },

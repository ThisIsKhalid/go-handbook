      "updated": 1,
      "link": null,
      "locked": false,
      "text": "V8 manages all memory.\nNo raw pointers exposed.\nSingle-threaded -> no data races.\nBut: large heap, slow startup,\nno true CPU parallelism.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "V8 manages all memory.\nNo raw pointers exposed.\nSingle-threaded -> no data races.\nBut: large heap, slow startup,\nno true CPU parallelism.",
      "lineHeight": 1.25
    },

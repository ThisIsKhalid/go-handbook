    },
    {
      "id": "ri0g6hsh",
      "type": "text",
      "x": 972,
      "y": 270,
      "width": 284,
      "height": 180,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 23928,
      "version": 1,
      "versionNonce": 75239,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Stack: 1-8MB OS thread (fixed)\nHeap: OS allocator (ptmalloc)\nGC: NONE - manual RAII/smart ptr\nSafety: unsafe (UB, buffer overflow)\nParallelism: OS threads (pthreads)\nKey: maximum control + speed",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Stack: 1-8MB OS thread (fixed)\nHeap: OS allocator (ptmalloc)\nGC: NONE - manual RAII/smart ptr\nSafety: unsafe (UB, buffer overflow)\nParallelism: OS threads (pthreads)\nKey: maximum control + speed",
      "lineHeight": 1.25

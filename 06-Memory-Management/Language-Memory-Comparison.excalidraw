      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Stack: 256KB-1MB per thread\nHeap: Eden + S1/S2 + Old + Meta\nGC: G1/ZGC/Shenandoah\nSafety: memory safe (NullPointerEx)\nParallelism: OS threads (heavy)\nKey: mature GC ecosystem",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Stack: 256KB-1MB per thread\nHeap: Eden + S1/S2 + Old + Meta\nGC: G1/ZGC/Shenandoah\nSafety: memory safe (NullPointerEx)\nParallelism: OS threads (heavy)\nKey: mature GC ecosystem",
      "lineHeight": 1.25
    },

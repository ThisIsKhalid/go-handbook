      }
    },
    {
      "id": "fs04injr",
      "type": "text",
      "x": 35,
      "y": 1848,
      "width": 1570,
      "height": 64,
      "angle": 0,
      "strokeColor": "#BE123C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 78562,
      "version": 1,
      "versionNonce": 69037,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "TRAP 1  Go is NOT the fastest - C++ and Rust beat it in CPU-bound tasks (no GC overhead). Go wins on dev speed + concurrency.\nTRAP 2  Node.js GC pauses can hit 50ms+ under memory pressure - bad for real-time APIs. Use Rust/Go for latency-sensitive paths.\nTRAP 3  Java startup time (200ms+) makes it poor for serverless/FaaS. GraalVM native-image helps but loses dynamic features.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "TRAP 1  Go is NOT the fastest - C++ and Rust beat it in CPU-bound tasks (no GC overhead). Go wins on dev speed + concurrency.\nTRAP 2  Node.js GC pauses can hit 50ms+ under memory pressure - bad for real-time APIs. Use Rust/Go for latency-sensitive paths.\nTRAP 3  Java startup time (200ms+) makes it poor for serverless/FaaS. GraalVM native-image helps but loses dynamic features.",
      "lineHeight": 1.25
    },
    {

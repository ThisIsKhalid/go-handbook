      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Return T, not *T.\nStack alloc = free!\nOnly use *T when:\n- Large struct (>~128B)\n- Need nil sentinel",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Return T, not *T.\nStack alloc = free!\nOnly use *T when:\n- Large struct (>~128B)\n- Need nil sentinel",
      "lineHeight": 1.25
    },

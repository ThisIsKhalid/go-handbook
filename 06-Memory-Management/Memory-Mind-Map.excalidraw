      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Expensive to create?\nPool and reuse!\npool.Get() -> use -> Put()\nCuts GC pressure\nin hot paths.",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Expensive to create?\nPool and reuse!\npool.Get() -> use -> Put()\nCuts GC pressure\nin hot paths.",
      "lineHeight": 1.25
    },

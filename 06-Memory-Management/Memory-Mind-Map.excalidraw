      "versionNonce": 82243,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "KEY INSIGHT: Stack = fast, automatic, per-function.  Heap = GC-managed, shared, slower.  Escape analysis = compiler chooses.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "KEY INSIGHT: Stack = fast, automatic, per-function.  Heap = GC-managed, shared, slower.  Escape analysis = compiler chooses.",
      "lineHeight": 1.25
    },
    {
      "id": "qfr66rl8",
      "type": "text",
      "x": 45,
      "y": 1984,
      "width": 1070,
      "height": 22,
      "angle": 0,

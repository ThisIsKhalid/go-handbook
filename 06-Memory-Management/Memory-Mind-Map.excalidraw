      "versionNonce": 69943,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Goal: keep variables on STACK as much as possible -> fewer heap allocations -> less GC work -> faster programs.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Goal: keep variables on STACK as much as possible -> fewer heap allocations -> less GC work -> faster programs.",
      "lineHeight": 1.25
    }

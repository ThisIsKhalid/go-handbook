      "versionNonce": 62596,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "var a any = val  COPIES!\nInterface boxing = heap alloc.\nUse concrete types in hot loops.\nGenerics (1.18+) = zero cost.",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "var a any = val  COPIES!\nInterface boxing = heap alloc.\nUse concrete types in hot loops.\nGenerics (1.18+) = zero cost.",
      "lineHeight": 1.25
    },

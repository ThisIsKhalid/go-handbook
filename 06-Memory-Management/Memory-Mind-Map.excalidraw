      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "GOGC=100 (default): GC when\nheap doubles. Set GOGC=200\nfor batch jobs (less GC).\nGOMEMLIMIT for containers.",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "GOGC=100 (default): GC when\nheap doubles. Set GOGC=200\nfor batch jobs (less GC).\nGOMEMLIMIT for containers.",
      "lineHeight": 1.25
    },

      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Goroutine stacks start at 2KB and grow on demand  |  Go heap uses size-class spans + per-P lock-free mcache",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Goroutine stacks start at 2KB and grow on demand  |  Go heap uses size-class spans + per-P lock-free mcache",
      "lineHeight": 1.25
    },

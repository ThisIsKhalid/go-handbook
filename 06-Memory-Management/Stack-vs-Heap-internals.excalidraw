      "versionNonce": 57537,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Directly requests N page spans\nfrom mheap global allocator\n\nmheap.alloc(npages) -> mspan\nTracked in mheap.largealloc treap\n\nGC sweep frees directly to mheap\nExamples: large buffers, big slices\n[]byte make([]byte, 1<<20)  -> here",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Directly requests N page spans\nfrom mheap global allocator\n\nmheap.alloc(npages) -> mspan\nTracked in mheap.largealloc treap\n\nGC sweep frees directly to mheap\nExamples: large buffers, big slices\n[]byte make([]byte, 1<<20)  -> here",
      "lineHeight": 1.25
    },

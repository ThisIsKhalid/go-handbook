    {
      "id": "xmecosfo",
      "type": "text",
      "x": 34,
      "y": 148,
      "width": 1572,
      "height": 95,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 23238,
      "version": 1,
      "versionNonce": 59823,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "// Stack: compiler-allocated, freed when function returns, no GC involvement\nfunc compute(x int) int { local := x * 2; return local }   // local stays on stack\n\n// Heap: runtime.mallocgc(), freed by GC, survives function return\nfunc newUser(name string) *User { return &User{Name: name} }  // User escapes -> heap alloc",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "// Stack: compiler-allocated, freed when function returns, no GC involvement\nfunc compute(x int) int { local := x * 2; return local }   // local stays on stack\n\n// Heap: runtime.mallocgc(), freed by GC, survives function return\nfunc newUser(name string) *User { return &User{Name: name} }  // User escapes -> heap alloc",
      "lineHeight": 1.25
    },

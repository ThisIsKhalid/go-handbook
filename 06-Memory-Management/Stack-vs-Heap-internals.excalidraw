      "opacity": 100,
      "seed": 98815,
      "version": 1,
      "versionNonce": 81643,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Packs multiple tiny objects into\none 16-byte block (no pointers!)\n\nstring/[]byte literals, small ints\nmcache.tiny pointer + tinyoffset\n\n~5x faster than regular alloc\nNo GC scan (no pointer fields)\nExample: int(42), bool, small struct",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Packs multiple tiny objects into\none 16-byte block (no pointers!)\n\nstring/[]byte literals, small ints\nmcache.tiny pointer + tinyoffset\n\n~5x faster than regular alloc\nNo GC scan (no pointer fields)\nExample: int(42), bool, small struct",
      "lineHeight": 1.25
    },

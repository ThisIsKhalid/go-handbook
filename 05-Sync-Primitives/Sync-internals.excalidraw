    {"id":"t_dirty_map","type":"text","x":610,"y":874,"width":500,"height":92,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2148,"version":1,"versionNonce":2248,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"dirty map (regular map, mutex-protected)\nSLOW PATH — needs mu.Lock()\nReceives new keys first\nStep ②: MISS → lock → check dirty\nStep ③: After N misses → promote dirty → read\n  (O(n) but resets miss counter)","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"dirty map (regular map, mutex-protected)\nSLOW PATH — needs mu.Lock()\nReceives new keys first\nStep ②: MISS → lock → check dirty\nStep ③: After N misses → promote dirty → read\n  (O(n) but resets miss counter)","lineHeight":1.25},

    {"id":"t_smap_miss_arrow","type":"text","x":506,"y":905,"width":90,"height":30,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2149,"version":1,"versionNonce":2249,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"MISS\n────→","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"MISS\n────→","lineHeight":1.25},
    {"id":"t_smap_note","type":"text","x":60,"y":978,"width":1060,"height":22,"angle":0,"strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2150,"version":1,"versionNonce":2250,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"BEST FOR: stable key sets written once, read many times.  NOT a general concurrent map replacement — use map+Mutex for frequent writes.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"BEST FOR: stable key sets written once, read many times.  NOT a general concurrent map replacement — use map+Mutex for frequent writes.","lineHeight":1.25},

    {"id":"r_remember","type":"rectangle","x":40,"y":1050,"width":1120,"height":110,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"#b2f2bb","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2151,"version":1,"versionNonce":2251,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"roundness":{"type":3}},
    {"id":"t_remember_title","type":"text","x":60,"y":1058,"width":200,"height":22,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2152,"version":1,"versionNonce":2252,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"REMEMBER","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"REMEMBER","lineHeight":1.25},
    {"id":"t_remember","type":"text","x":60,"y":1084,"width":1080,"height":68,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2153,"version":1,"versionNonce":2253,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"  Mutex: 1 int32 packs locked+woken+starving+waiterCount | starvation mode at >1ms wait\n  RWMutex: multiple concurrent readers OR one exclusive writer | readerCount goes negative for writer\n  WaitGroup: Add() before goroutine start | Done() = Add(-1) | Wait() blocks until count=0\n  Once: fast path = one atomic load | slow path = mutex+double-check | f() runs EXACTLY once\n  sync.Map: lock-free reads via read map, mutex-protected dirty map | best for stable read-heavy key sets","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"  Mutex: 1 int32 packs locked+woken+starving+waiterCount | starvation mode at >1ms wait\n  RWMutex: multiple concurrent readers OR one exclusive writer | readerCount goes negative for writer\n  WaitGroup: Add() before goroutine start | Done() = Add(-1) | Wait() blocks until count=0\n  Once: fast path = one atomic load | slow path = mutex+double-check | f() runs EXACTLY once\n  sync.Map: lock-free reads via read map, mutex-protected dirty map | best for stable read-heavy key sets","lineHeight":1.25}

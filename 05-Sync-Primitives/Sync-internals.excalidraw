    {"id":"t_read_map","type":"text","x":70,"y":874,"width":420,"height":92,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2146,"version":1,"versionNonce":2246,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"read map (atomic.Pointer)\nFAST PATH — NO LOCK needed!\nChecked with atomic load\nAll goroutines read concurrently\nStep ①: Load() checks here first","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"read map (atomic.Pointer)\nFAST PATH — NO LOCK needed!\nChecked with atomic load\nAll goroutines read concurrently\nStep ①: Load() checks here first","lineHeight":1.25},


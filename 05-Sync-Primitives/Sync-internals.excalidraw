    {"id":"t_readers_ok","type":"text","x":60,"y":530,"width":420,"height":22,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2132,"version":1,"versionNonce":2232,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"All reading simultaneously — readerCount=3, no blocking","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"All reading simultaneously — readerCount=3, no blocking","lineHeight":1.25},
    {"id":"r_writer","type":"rectangle","x":530,"y":474,"width":580,"height":50,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"#ffc9c9","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2133,"version":1,"versionNonce":2233,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"roundness":{"type":3}},
    {"id":"t_writer","type":"text","x":533,"y":476,"width":574,"height":46,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2134,"version":1,"versionNonce":2234,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"G4 WRITING (Lock) — BLOCKS all readers AND writers\nSets readerCount NEGATIVE → new readers see it and block","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"G4 WRITING (Lock) — BLOCKS all readers AND writers\nSets readerCount NEGATIVE → new readers see it and block","lineHeight":1.25},
    {"id":"t_rw_tip","type":"text","x":60,"y":554,"width":1060,"height":22,"angle":0,"strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2135,"version":1,"versionNonce":2235,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"MENTAL MODEL: RWMutex = library. Many people can read books simultaneously, but one person writing requires everyone to leave first.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"MENTAL MODEL: RWMutex = library. Many people can read books simultaneously, but one person writing requires everyone to leave first.","lineHeight":1.25},

    {"id":"t_sec3","type":"text","x":40,"y":616,"width":1120,"height":26,"angle":0,"strokeColor":"#7048e8","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2136,"version":1,"versionNonce":2236,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"③ sync.WaitGroup & sync.Once — The Coordinator and the Gate","fontSize":18,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"③ sync.WaitGroup & sync.Once — The Coordinator and the Gate","lineHeight":1.25},

    {"id":"r_wg_bg","type":"rectangle","x":40,"y":650,"width":540,"height":150,"angle":0,"strokeColor":"#7048e8","backgroundColor":"#f3d9fa","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2137,"version":1,"versionNonce":2237,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"roundness":{"type":3}},
    {"id":"t_wg_title","type":"text","x":60,"y":658,"width":500,"height":22,"angle":0,"strokeColor":"#7048e8","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2138,"version":1,"versionNonce":2238,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"sync.WaitGroup  (RACE FINISH LINE)","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"sync.WaitGroup  (RACE FINISH LINE)","lineHeight":1.25},
    {"id":"t_wg_body","type":"text","x":60,"y":684,"width":510,"height":110,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2139,"version":1,"versionNonce":2239,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"wg.Add(3)  →  counter = 3\ngo work1(); go work2(); go work3()\nwg.Wait()  →  main blocks (waiter=1)\n  work1 calls Done() → counter = 2\n  work2 calls Done() → counter = 1\n  work3 calls Done() → counter = 0 → wake all waiters!\nstate = packed Uint64: [counter|waiter] | sema uint32","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"wg.Add(3)  →  counter = 3\ngo work1(); go work2(); go work3()\nwg.Wait()  →  main blocks (waiter=1)\n  work1 calls Done() → counter = 2\n  work2 calls Done() → counter = 1\n  work3 calls Done() → counter = 0 → wake all waiters!\nstate = packed Uint64: [counter|waiter] | sema uint32","lineHeight":1.25},

    {"id":"r_once_bg","type":"rectangle","x":620,"y":650,"width":540,"height":150,"angle":0,"strokeColor":"#e67700","backgroundColor":"#fff9db","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2140,"version":1,"versionNonce":2240,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"roundness":{"type":3}},
    {"id":"t_once_title","type":"text","x":640,"y":658,"width":500,"height":22,"angle":0,"strokeColor":"#e67700","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2141,"version":1,"versionNonce":2241,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"sync.Once  (THE GATE THAT OPENS ONCE)","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"sync.Once  (THE GATE THAT OPENS ONCE)","lineHeight":1.25},
    {"id":"t_once_body","type":"text","x":640,"y":684,"width":510,"height":110,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2142,"version":1,"versionNonce":2242,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"FAST PATH (99% of calls — after first):\n  atomic.Load(&done) == 1? YES → return immediately\n  Zero mutex cost! Just one atomic read.\n\nSLOW PATH (first call only):\n  Lock → check done again (double-check) → run f()\n  atomic.Store(&done, 1) → unlock\n  Guarantees f() runs EXACTLY once even with 1000 goroutines","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"FAST PATH (99% of calls — after first):\n  atomic.Load(&done) == 1? YES → return immediately\n  Zero mutex cost! Just one atomic read.\n\nSLOW PATH (first call only):\n  Lock → check done again (double-check) → run f()\n  atomic.Store(&done, 1) → unlock\n  Guarantees f() runs EXACTLY once even with 1000 goroutines","lineHeight":1.25},

    {"id":"t_sec4","type":"text","x":40,"y":820,"width":1120,"height":26,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2143,"version":1,"versionNonce":2243,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"④ sync.Map — Two Maps Are Better Than One","fontSize":18,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"④ sync.Map — Two Maps Are Better Than One","lineHeight":1.25},


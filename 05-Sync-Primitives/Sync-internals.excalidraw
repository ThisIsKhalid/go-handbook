    {"id":"r_normal_mode","type":"rectangle","x":60,"y":228,"width":500,"height":80,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"#b2f2bb","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2116,"version":1,"versionNonce":2216,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"roundness":{"type":3}},
    {"id":"t_normal_mode","type":"text","x":70,"y":232,"width":480,"height":72,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2117,"version":1,"versionNonce":2217,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"NORMAL MODE (starvation bit=0)\n  New goroutines COMPETE with sleeping ones\n  Goroutine may spin (~4 iterations) before sleeping\n  Can steal lock from a woken-but-not-yet-scheduled goroutine\n  Higher throughput, but a goroutine COULD wait forever","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"NORMAL MODE (starvation bit=0)\n  New goroutines COMPETE with sleeping ones\n  Goroutine may spin (~4 iterations) before sleeping\n  Can steal lock from a woken-but-not-yet-scheduled goroutine\n  Higher throughput, but a goroutine COULD wait forever","lineHeight":1.25},

    {"id":"r_starve_mode","type":"rectangle","x":600,"y":228,"width":540,"height":80,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"#ffc9c9","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2118,"version":1,"versionNonce":2218,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"roundness":{"type":3}},
    {"id":"t_starve_mode","type":"text","x":610,"y":232,"width":520,"height":72,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2119,"version":1,"versionNonce":2219,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"STARVATION MODE (starvation bit=1) — kicks in after 1ms wait\n  Lock handed DIRECTLY to longest-waiting goroutine\n  New goroutines queue at the back — NO stealing allowed\n  Revert to normal: last waiter OR wait time < 1ms\n  Ensures fairness: no goroutine waits more than ~1ms","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"STARVATION MODE (starvation bit=1) — kicks in after 1ms wait\n  Lock handed DIRECTLY to longest-waiting goroutine\n  New goroutines queue at the back — NO stealing allowed\n  Revert to normal: last waiter OR wait time < 1ms\n  Ensures fairness: no goroutine waits more than ~1ms","lineHeight":1.25},

    {"id":"t_mode_arrow","type":"text","x":540,"y":254,"width":60,"height":30,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2120,"version":1,"versionNonce":2220,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":">1ms\n───→","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":">1ms\n───→","lineHeight":1.25},
    {"id":"t_mutex_tip","type":"text","x":60,"y":316,"width":1060,"height":22,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2121,"version":1,"versionNonce":2221,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"TRAP: Never copy a Mutex after first use — copy the pointer! type Server struct { mu sync.Mutex } → pass *Server, not Server","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"TRAP: Never copy a Mutex after first use — copy the pointer! type Server struct { mu sync.Mutex } → pass *Server, not Server","lineHeight":1.25},
    {"id":"t_mutex_tip2","type":"text","x":60,"y":340,"width":1060,"height":22,"angle":0,"strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2122,"version":1,"versionNonce":2222,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"MENTAL MODEL: Mutex = bathroom lock. One person at a time. Normal mode = first come first served. Starvation mode = skip the line after waiting >1ms.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"MENTAL MODEL: Mutex = bathroom lock. One person at a time. Normal mode = first come first served. Starvation mode = skip the line after waiting >1ms.","lineHeight":1.25},
    {"id":"t_mutex_tip3","type":"text","x":60,"y":364,"width":1060,"height":22,"angle":0,"strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":2123,"version":1,"versionNonce":2223,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"go vet detects copying of sync.Mutex — always run go vet before committing!","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"go vet detects copying of sync.Mutex — always run go vet before committing!","lineHeight":1.25},


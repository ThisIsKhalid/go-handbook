    {
      "id": "g_M_txt",
      "type": "text",
      "x": 635,
      "y": 234,
      "width": 275,
      "height": 180,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 94236,
      "version": 1,
      "versionNonce": 94236,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "M  (OS thread)\n──────────────────\ncurP *P      ← bound P\ncurG *G      ← running G\ntls          ← thread-local\nblocked M releases P\nNew M on blocking syscall\nOne M per CPU core (active)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "M  (OS thread)\n──────────────────\ncurP *P      ← bound P\ncurG *G      ← running G\ntls          ← thread-local\nblocked M releases P\nNew M on blocking syscall\nOne M per CPU core (active)",
      "lineHeight": 1.25
    },
    {
      "id": "g_step2",
      "type": "text",
      "x": 40,
      "y": 440,
      "width": 880,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 30959,
      "version": 1,
      "versionNonce": 30959,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "② Work stealing: idle P steals half of a busy P's local run queue — keeps all cores busy:",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "② Work stealing: idle P steals half of a busy P's local run queue — keeps all cores busy:",
      "lineHeight": 1.25
    },
    {
      "id": "g_steal_bg",
      "type": "rectangle",
      "x": 40,
      "y": 468,
      "width": 425,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#dbe4ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 75343,
      "version": 1,
      "versionNonce": 75343,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "roundness": {
        "type": 3
      }
    },
    {
      "id": "g_steal_txt",
      "type": "text",
      "x": 55,
      "y": 476,
      "width": 405,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1b4b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 33053,
      "version": 1,
      "versionNonce": 33053,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "P0 (busy):  runq = [G1, G2, G3, G4, G5, G6]\nP1 (idle):  runq = []\n\nP1 steals half → P0=[G1,G2,G3]  P1=[G4,G5,G6]\nBoth Ps now executing goroutines!",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P0 (busy):  runq = [G1, G2, G3, G4, G5, G6]\nP1 (idle):  runq = []\n\nP1 steals half → P0=[G1,G2,G3]  P1=[G4,G5,G6]\nBoth Ps now executing goroutines!",
      "lineHeight": 1.25
    },
    {

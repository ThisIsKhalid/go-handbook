      "opacity": 100,
      "seed": 13674,
      "version": 1,
      "versionNonce": 13674,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "G  (goroutine)\n──────────────────\nstack ptr\nprogram counter\nstatus: running |\n  waiting | runnable\nsched: saved regs\nstartfn pointer\nstack: 2KB → 1GB",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "G  (goroutine)\n──────────────────\nstack ptr\nprogram counter\nstatus: running |\n  waiting | runnable\nsched: saved regs\nstartfn pointer\nstack: 2KB → 1GB",
      "lineHeight": 1.25
    },
    {

    {
      "id": "g_P_txt",
      "type": "text",
      "x": 340,
      "y": 234,
      "width": 250,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 93701,
      "version": 1,
      "versionNonce": 93701,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "P  (processor)\n──────────────────\nrunq [256]G  ← local queue\nrunnext *G   ← next G\nmcache       ← memory cache\ncurG *G      ← running now\nGOMAXPROCS Ps exist\n(default = CPU count)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P  (processor)\n──────────────────\nrunq [256]G  ← local queue\nrunnext *G   ← next G\nmcache       ← memory cache\ncurG *G      ← running now\nGOMAXPROCS Ps exist\n(default = CPU count)",
      "lineHeight": 1.25
    },
    {

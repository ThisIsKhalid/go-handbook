    {
      "id": "g_sys_txt",
      "type": "text",
      "x": 500,
      "y": 476,
      "width": 415,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e3a1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 0,
      "opacity": 100,
      "seed": 38699,
      "version": 1,
      "versionNonce": 38699,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Blocking syscall (e.g., os.Read):\nG calls syscall → M enters kernel (blocks)\nRuntime: M detaches from P\nP immediately gets a new M to stay busy\nOld M resumes after syscall, re-acquires a P",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Blocking syscall (e.g., os.Read):\nG calls syscall → M enters kernel (blocks)\nRuntime: M detaches from P\nP immediately gets a new M to stay busy\nOld M resumes after syscall, re-acquires a P",
      "lineHeight": 1.25
    },

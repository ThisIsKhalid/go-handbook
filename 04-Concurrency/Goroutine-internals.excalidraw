      "versionNonce": 44961,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "💡 MENTAL MODEL:  G = lightweight task (2KB stack),  P = virtual CPU slot,  M = real OS thread\n                  GOMAXPROCS=4 → 4 Ps → at most 4 goroutines truly parallel at one time\n                  Stack grows dynamically: starts 2KB, doubles on overflow, max 1GB (default)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "💡 MENTAL MODEL:  G = lightweight task (2KB stack),  P = virtual CPU slot,  M = real OS thread\n                  GOMAXPROCS=4 → 4 Ps → at most 4 goroutines truly parallel at one time\n                  Stack grows dynamically: starts 2KB, doubles on overflow, max 1GB (default)",
      "lineHeight": 1.25
    },

      "version": 1,
      "versionNonce": 4847,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "⚠ TRAP — Goroutine leak:\n  go func() { for v := range ch { process(v) } }()  // if ch never closes, goroutine lives FOREVER\n  FIX: pass ctx context.Context and select on ctx.Done() to allow cancellation",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⚠ TRAP — Goroutine leak:\n  go func() { for v := range ch { process(v) } }()  // if ch never closes, goroutine lives FOREVER\n  FIX: pass ctx context.Context and select on ctx.Done() to allow cancellation",
      "lineHeight": 1.25
    },

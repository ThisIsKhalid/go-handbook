      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "✓ REMEMBER:  runtime.NumGoroutine() counts them; use pprof goroutine profile to detect leaks\n             Goroutines are NOT 1:1 with OS threads — millions can coexist\n             Use sync.WaitGroup or errgroup.Group to wait for goroutines to complete",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "✓ REMEMBER:  runtime.NumGoroutine() counts them; use pprof goroutine profile to detect leaks\n             Goroutines are NOT 1:1 with OS threads — millions can coexist\n             Use sync.WaitGroup or errgroup.Group to wait for goroutines to complete",
      "lineHeight": 1.25
    }

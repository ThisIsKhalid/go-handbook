      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "① The GMP model: G (goroutine task) + M (OS thread) + P (processor context, GOMAXPROCS of them):",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "① The GMP model: G (goroutine task) + M (OS thread) + P (processor context, GOMAXPROCS of them):",
      "lineHeight": 1.25
    },
    {

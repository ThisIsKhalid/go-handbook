      "updated": 1,
      "link": null,
      "locked": false,
      "text": "⚠ TRAP:  for v := range ch {}  — blocks FOREVER if nobody calls close(ch)!\n         Sending to a nil channel: blocks forever (no panic)\n         Sending to a CLOSED channel: panic: send on closed channel",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⚠ TRAP:  for v := range ch {}  — blocks FOREVER if nobody calls close(ch)!\n         Sending to a nil channel: blocks forever (no panic)\n         Sending to a CLOSED channel: panic: send on closed channel",
      "lineHeight": 1.25
    },

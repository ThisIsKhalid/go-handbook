      "seed": 83799,
      "version": 1,
      "versionNonce": 83799,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "hchan struct {\n  qcount   uint  = 1      // items in buf\n  dataqsiz uint  = 3      // capacity\n  buf      *[3]int        // ring buffer ptr\n  sendx    uint  = 1      // next write pos\n  recvx    uint  = 0      // next read pos\n  lock     mutex\n  sendq    waitq          // parked senders\n  recvq    waitq          // parked receivers\n}",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "hchan struct {\n  qcount   uint  = 1      // items in buf\n  dataqsiz uint  = 3      // capacity\n  buf      *[3]int        // ring buffer ptr\n  sendx    uint  = 1      // next write pos\n  recvx    uint  = 0      // next read pos\n  lock     mutex\n  sendq    waitq          // parked senders\n  recvq    waitq          // parked receivers\n}",
      "lineHeight": 1.25
    },

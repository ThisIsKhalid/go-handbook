      "updated": 1,
      "link": null,
      "locked": false,
      "text": "💡 MENTAL MODEL:  channel = ring_buf + lock + parked_senders(sendq) + parked_receivers(recvq)\n                  Unbuffered: make(chan T) = capacity 0 = sender and receiver MUST meet simultaneously\n                  Buffered: sender proceeds if space available; receiver if data available",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "💡 MENTAL MODEL:  channel = ring_buf + lock + parked_senders(sendq) + parked_receivers(recvq)\n                  Unbuffered: make(chan T) = capacity 0 = sender and receiver MUST meet simultaneously\n                  Buffered: sender proceeds if space available; receiver if data available",
      "lineHeight": 1.25
    },

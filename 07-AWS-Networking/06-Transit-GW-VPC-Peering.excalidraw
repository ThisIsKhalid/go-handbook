"y": 1607, "width": 1276, "height": 22, "strokeColor": "#FFFFFF", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Direct Connect \u2014 Dedicated Physical Fiber to AWS (No Internet!)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Direct Connect \u2014 Dedicated Physical Fiber to AWS (No Internet!)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 67269, "version": 1, "versionNonce": 32732, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "9b80bea0cf2430c6", "type": "arrow", "x": 2310, "y": 1500, "width": 611, "height": 351, "strokeColor": "#06B6D4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 4, "points": [[0, 0], [-106, 168], [-228, 309], [-480, 222], [-610, 350]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null, "roundness": {"type": 2}, "angle": 0, "roughness": 2, "opacity": 100, "seed": 99883, "version": 1, "versionNonce": 87058, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "eb316ae2818ad223", "type": "text", "x": 1720, "y": 1650, "width": 1260, "height": 40, "strokeColor": "#CBD5E1", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Think of Direct Connect like having your own private highway to AWS.\nNo internet traffic, no congestion, consistent speed \u2014 like a dedicated express lane.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Think of Direct Connect like having your own private highway to AWS.\nNo internet traffic, no congestion, consistent speed \u2014 like a dedicated express lane.", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 58856, "version": 1, "versionNonce": 29811, "isDeleted": false, "boundElement
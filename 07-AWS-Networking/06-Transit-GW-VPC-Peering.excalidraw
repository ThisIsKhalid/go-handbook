text", "x": 730, "y": 1858, "width": 56, "height": 18, "strokeColor": "#60A5FA", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Cache", "fontSize": 10, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Cache", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 91680, "version": 1, "versionNonce": 41151, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "c41e4dd0cad39cbf", "type": "ellipse", "x": 850, "y": 1720, "width": 24, "height": 24, "strokeColor": "#059669", "backgroundColor": "#064E3B", "fillStyle": "solid", "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 41159, "version": 1, "versionNonce": 85339, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "f9a24c801692dbcc", "type": "text", "x": 854, "y": 1723, "width": 16, "height": 16, "strokeColor": "#FFFFFF", "backgroundColor": "transparent", "fillStyle": "solid", "text": "4", "fontSize": 11, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "4", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 40392, "version": 1, "versionNonce": 66867, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "96953ab1ead5c9f0", "type": "text", "x": -80, "y": 1900, "width": 1160, "height": 120, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "HOW IT WORKS:\n\u2460 Your office router (Customer Gateway) initiates 2 encrypted IPSec tunnels to AWS\n\u2461 Tunnels go over the public internet but data is encrypted (AES-256) \u2014 nobody can read it\n\u2462 On AWS side, Virtual Private Gateway (or Transit Gateway) receives the tunnels\n\u2463 VPC route table: 192.168.1.0/24 (office network) \u2192 vgw-xxx \u2014 traffic goes to your office\n\nSpeed: ~1.25 Gbps per tunnel  |  Setup: ~10 minutes  |  Cost: $0.05/hr ($36/month)\nTWO tunnels for high availability \u2014 if one breaks, traffic auto-switches to the other", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "HOW IT WORKS:\n\u2460 Your office router (Customer Gateway) initiates 2 encrypted IPSec tunnels to AWS\n\u2461 Tunnels go over the public internet but data is encrypted (AES-256) \u2014 nobody can read it\n\u2462 On AWS side, Virtual Private Gateway (or Transit Gateway) receives the tunnels\n\u2463 VPC route table: 192.168.1.0/24 (office network) \u2192 vgw-xxx \u2014 traffic goes to your office\n\nSpeed: ~1.25 Gbps per tunnel  |  Setup: ~10 minutes  |  Cost: $0.05/hr ($36/month)\nTWO tunnels for high availability \u2014 if one breaks, traffic auto-switches to the other", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 11995, "version": 1, "versionNonce": 18292, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "eaf9edeb4b09f2f7", "type": "rectangle", "x": 2090, "y": 1465, "width": 220, "height": 70, "strokeColor": "#06B6D4", "backgroundColor": "#164E63", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 15748, "version": 1, "versionNonce": 39448, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "7ae0b13b93a32204", "type": "image", "x": 2100, "y": 1482, "width": 36, "height": 36, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "fileId": "57ae8d15f16683b9cbae0bdd4b423a118625e25a", "scale": [1, 1], "status": "saved", "angle": 0, "roughness": 0, "opacity": 100, "seed": 62203, "version": 1, "versionNonce": 92671, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "2bc9dba6cd50805c", "type
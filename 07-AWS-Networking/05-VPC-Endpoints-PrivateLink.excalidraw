": "center", "verticalAlign": "top", "containerId": null, "originalText": "Consumer", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 22847, "version": 1, "versionNonce": 90659, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e25cffe0c41c2b26", "type": "text", "x": 1240, "y": 1655, "width": 90, "height": 16, "strokeColor": "#E2E8F0", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Consumer\nApp", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Consumer\nApp", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 20196, "version": 1, "versionNonce": 32251, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "470cc105cc3929bb", "type": "text", "x": 1170, "y": 1707, "width": 160, "height": 16, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Calls your service", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Calls your service", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 38624, "version": 1, "versionNonce": 53435, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "0127c4673c624a83", "type": "arrow", "x": 1090, "y": 1685, "width": 71, "height": 1, "strokeColor": "#06B6D4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "points": [[0, 0], [70, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "roundness": {"type": 2}, "angle": 0, "roughness": 0, "opacity": 100, "seed": 80582, "version": 1, "versionNonce": 27340, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "41411beea8cf97ee", "type": "text", "x": 650, "y": 1625, "width": 180, "height": 16, "strokeColor": "#EC4899", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2190 Cross-Account \u2192", "fontSize": 12, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "\u2190 Cross-Account \u2192", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 89178, "version": 1, "versionNonce": 78110, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "18c4a07d8e25d727", "type": "text", "x": 80, "y": 1855, "width": 1440, "height": 60, "strokeColor": "#E2E8F0", "backgroundColor": "transparent", "fillStyle": "solid", "text": "You can expose your own service to OTHER AWS accounts privately \u2014 like having a secret\nback door between buildings. The consumer creates an Interface Endpoint that connects to\nYOUR NLB via PrivateLink. No internet, no VPC peering needed!", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "You can expose your own service to OTHER AWS accounts privately \u2014 like having a secret\nback door between buildings. The consumer creates an Interface Endpoint that connects to\nYOUR NLB via PrivateLink. No internet, no VPC peering needed!", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 96506, "version": 1, "versionNonce": 37163, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "5c66f235c3a19995", "type": "text", "x": 80, "y": 1915, "width": 1440, "height": 18, "strokeColor": "#EC4899", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Key Facts:", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Key Facts:", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 55377, "version": 1, "versionNonce": 50522, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "04c00ee7733d5e08", "type": "text", "x": 80, "y": 1937, "width": 1440, "height": 18, "strokeColor": "#E2E8F0", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 Provider needs an NLB (Network Load Balancer) \u2014 PrivateLink connects to NLB only", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 Provider needs an NLB (Network Load Balancer) \u2014 PrivateLink connects to NLB only", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 47370, "version": 1, "versionNonce": 86802, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "72fa42a97a52110f", "type": "text", "x": 80, "y": 1955, "width": 1440, "height": 18, "strokeColor": "#E2E8F0", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 Consumer creates Interface Endpoint \u2192 gets ENI with private IP", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 Consumer creates Interface Endpoint \u2192 gets ENI with private IP", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 42498, "version": 1, "versionNonce": 53986, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "ad6ff72948dc46f9", "type": "text", "x": 80, "y": 1973, "width": 1440, "height": 18, "strokeColor": "#E2E8F0", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 Provider must approve connection requests (whitelist accounts)", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 Provider must approve connection requests (whitelist accounts)", "lineHeight": 1.25, "angle": 0, "strokeWid
ivate IP\ninstead of the public one \u2014 traffic stays private and never leaves the AWS network!", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 58076, "version": 1, "versionNonce": 71963, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "589745ea81fbe246", "type": "text", "x": 1680, "y": 1935, "width": 1040, "height": 18, "strokeColor": "#06B6D4", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Key Facts:", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Key Facts:", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 77271, "version": 1, "versionNonce": 53044, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "d63784024c14a85c", "type": "text", "x": 1680, "y": 1957, "width": 1040, "height": 18, "strokeColor": "#E2E8F0", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 $0.01/hr per AZ + $0.01/GB data processed", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 $0.01/hr per AZ + $0.01/GB data processed", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 18895, "version": 1, "versionNonce": 82476, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e18aebd82cfe0d83", "type": "text", "x": 1680, "y": 1975, "width": 1040, "height": 18, "strokeColor": "#E2E8F0", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 Supports 100+ AWS services (SQS, KMS, SSM, ECR, etc.)", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 Supports 100+ AWS services (SQS, KMS, SSM, ECR, etc.)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacit
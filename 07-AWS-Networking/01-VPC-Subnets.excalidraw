00, "height": 34, "strokeColor": "#7C3AED", "backgroundColor": "#7C3AED", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 44507, "version": 1, "versionNonce": 92787, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "19b375c1e3e236b2", "type": "text", "x": 712, "y": -193, "width": 1376, "height": 22, "strokeColor": "#FFFFFF", "backgroundColor": "transparent", "fillStyle": "solid", "text": "What is a VPC?  \u2014  Your Own Private Network Inside AWS", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What is a VPC?  \u2014  Your Own Private Network Inside AWS", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 98119, "version": 1, "versionNonce": 57776, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "dd4e65f5521fb739", "type": "arrow", "x": 1400, "y": 465, "width": 1, "height": 66, "strokeColor": "#7C3AED", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 4, "points": [[0, 0], [-10, -19], [-14, -32], [-10, -45], [0, -65]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null, "roundness": {"type": 2}, "angle": 0, "roughness": 2, "opacity": 100, "seed": 79134, "version": 1, "versionNonce": 92996, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "1550525588cca895", "type": "text", "x": 720, "y": -150, "width": 1360, "height": 60, "strokeColor": "#CBD5E1", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Think of a VPC like renting your own private floor in a huge office building (AWS).\nNobody else can see or access your floor. You decide how to divide the rooms (subnets),\nwho can enter (security groups), and which doors lead outside (internet gateway).", "f
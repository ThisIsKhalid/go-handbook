 "x": 620, "y": 1695, "width": 320, "height": 80, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2460 User types URL\n\u2461 DNS \u2192 public IP of EC2\n\u2462 IGW translates public\u2192private IP\n\u2463 Route table sends to right subnet\n\u2464 EC2 receives the request", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2460 User types URL\n\u2461 DNS \u2192 public IP of EC2\n\u2462 IGW translates public\u2192private IP\n\u2463 Route table sends to right subnet\n\u2464 EC2 receives the request", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 16408, "version": 1, "versionNonce": 52253, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "4c0b28850ecf31aa", "type": "text", "x": -80, "y": 1830, "width": 800, "height": 20, "strokeColor": "#60A5FA", "backgroundColor": "transparent", "fillStyle": "solid", "text": "PRIVATE SUBNET \u2014 Can only SEND traffic OUT (not receive from internet)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "PRIVATE SUBNET \u2014 Can only SEND traffic OUT (not receive from internet)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 27189, "version": 1, "versionNonce": 37013, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "981d6304ef2ecb11", "type": "rectangle", "x": -80, "y": 1858, "width": 1040, "height": 130, "strokeColor": "#2563EB", "backgroundColor": "#0a1e3e", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 60956, "version": 1, "versionNonce": 83567, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "a25e1ae22541d98c", "type": "rectangle", "x": -60, "y": 1868, "widt
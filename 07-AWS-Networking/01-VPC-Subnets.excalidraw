ments": null, "updated": 1, "link": null, "locked": false}, {"id": "c754d2edb1697fdc", "type": "image", "x": 2560, "y": 1735, "width": 36, "height": 36, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "fileId": "f73fbeaa5233f3af60224f3adbdb73b6c8c400f1", "scale": [1, 1], "status": "saved", "angle": 0, "roughness": 0, "opacity": 100, "seed": 66643, "version": 1, "versionNonce": 40618, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "62f555183ff911eb", "type": "text", "x": 2550, "y": 1775, "width": 56, "height": 18, "strokeColor": "#A78BFA", "backgroundColor": "transparent", "fillStyle": "solid", "text": "VPC\nEndpoint", "fontSize": 10, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "VPC\nEndpoint", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 31572, "version": 1, "versionNonce": 23801, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "2331fb82dbdd001a", "type": "text", "x": 2440, "y": 1795, "width": 290, "height": 75, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "AWS services accessed only\nvia VPC Endpoints\nFor: banks, healthcare, gov\nPCI-DSS, HIPAA compliance", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "AWS services accessed only\nvia VPC Endpoints\nFor: banks, healthcare, gov\nPCI-DSS, HIPAA compliance", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 14575, "version": 1, "versionNonce": 15195, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e2b55f75f0141ade", "type": "text", "x": 1720, "y": 1895, "width": 1060, "height": 100, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "CIDR PLANNING EXAMPLE:     VPC = 10.0.0.0/16  (65,536 IPs \u2014 plenty of room)\n\n  Public-1a:  10.0.1.0/24   (256 IPs)     Public-1b:  10.0.2.0/24   (256 IPs)\n  App-1a:     10.0.10.0/24  (256 IPs)     App-1b:     10.0.11.0/24  (256 IPs)\n  Data-1a:    10.0.20.0/24  (256 IPs)     Data-1b:    10.0.21.0/24  (256 IPs)\n\n  Reserved per subnet: 5 IPs (network, router, DNS, future, broadcast) \u2192 251 usable per /24", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CIDR PLANNING EXAMPLE:     VPC = 10.0.0.0/16  (65,536 IPs \u2014 plenty of room)\n\n  Public-1a:  10.0.1.0/24   (256 IPs)     Public-1b:  10.0.2.0/24   (256 IPs)\n  App-1a:     10.0.10.0/24  (256 IPs)     App-1b:     10.0.11.0/24  (256 IPs)\n  Data-1a:    10.0.20.0/24  (256 IPs)     Data-1b:    10.0.21.0/24  (256 IPs)\n\n  Reserved per subnet: 5 IPs (network, router, DNS, future, broadcast) \u2192 251 usable per /24", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 98977, "version": 1, "versionNonce": 53148, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}], "appState": {"gridSize": null, "viewBackgroundColor": "#0F172A"}, "files": {"4d0fb475b242228032cbdf6d53924d2538df037b": {"mimeType": "image/svg+xml", "id": "4d0fb475b242228032cbdf6d53924d2538df037b", "dataURL": "data:image/svg+xml;base64,", "created": 1709164800000, "lastRetrieved": 1709164800000}, "10bd3a19a8ee4452666e66cd5a6a7e36f2c8fffd": {"mimeType": "image/svg+xml", "id": "10bd3a19a8ee4452666e66cd5a6a7e36f2c8fffd", "dataURL": "data:image/svg+xml;base64,", "created": 1709164800000, "lastRetrieved": 1709164800000}, "80ad2de755faf5339dd68ac77cef9277ccff14b2": {"mimeType": "image/svg+xml", "id": "80ad2de755faf5339dd68ac77cef9277ccff14b2", "dataURL": "data:image/svg+xml;base64,", "created": 1709164800000, "lastRetrieved": 1709164800000}, "7a4d83bfae2c407b9d0c5270eb1d1a08527ce9db": {"mimeType": "image
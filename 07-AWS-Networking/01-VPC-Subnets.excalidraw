: false}, {"id": "5fe852cce701326e", "type": "arrow", "x": 980, "y": 283, "width": 1, "height": 11, "strokeColor": "#F59E0B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "points": [[0, 0], [0, -10]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "roundness": {"type": 2}, "angle": 0, "roughness": 0, "opacity": 100, "seed": 53349, "version": 1, "versionNonce": 54445, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "398ccc299df41db2", "type": "text", "x": 720, "y": 300, "width": 1360, "height": 70, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "HOW IT WORKS:  \u2460 Internet traffic arrives  \u2192  \u2461 Internet Gateway routes it into VPC  \u2192\n\u2462 Public subnets have ALB and NAT Gateway (directly reachable from internet)  \u2192\n\u2463 Private subnets have app servers and databases (NOT reachable from internet \u2014 protected!)\n\nMultiple AZs = if one data center fails, the other keeps running. Always use at least 2 AZs.", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "HOW IT WORKS:  \u2460 Internet traffic arrives  \u2192  \u2461 Internet Gateway routes it into VPC  \u2192\n\u2462 Public subnets have ALB and NAT Gateway (directly reachable from internet)  \u2192\n\u2463 Private subnets have app servers and databases (NOT reachable from internet \u2014 protected!)\n\nMultiple AZs = if one data center fails, the other keeps running. Always use at least 2 AZs.", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 58934, "version": 1, "versionNonce": 34239, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "2fd9bc3e812227d0", "type": "rectangle", "x": 400, "y": 865, "width": 200, "height": 70, "strokeColor": "#F59E0B"
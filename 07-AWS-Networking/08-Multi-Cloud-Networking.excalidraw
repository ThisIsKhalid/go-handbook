		{
			"id": "euIOC1iN",
			"type": "text",
			"x": -285,
			"y": 990,
			"width": 597.5234375,
			"height": 206.25,
			"strokeColor": "#94A3B8",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"text": "HOW IT WORKS:\n① Your office router is registered as a Customer Gateway in AWS (just its public IP)\n② AWS creates 2 IPSec tunnels to your router (2 for backup — if one fails, other takes over)\n③ Traffic is encrypted (AES-256) and sent over the public internet to AWS\n④ On AWS side, Virtual Private Gateway (or TGW) receives and routes to your VPC\n\nWHEN TO USE VPN:\n• Quick setup needed (minutes vs weeks for Direct Connect)\n• Budget-friendly ($36/month)\n• Backup connection for Direct Connect\n• Low-medium bandwidth needs (up to 1.25 Gbps per tunnel)\n• Development/testing environments\n\nSPECS:  Speed: 1.25 Gbps/tunnel  |  Encryption: AES-256  |  2 tunnels (HA)\n        BGP or static routing  |  IKEv1/v2  |  $0.05/hr + data transfer",
			"fontSize": 11,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "HOW IT WORKS:\n① Your office router is registered as a Customer Gateway in AWS (just its public IP)\n② AWS creates 2 IPSec tunnels to your router (2 for backup — if one fails, other takes over)\n③ Traffic is encrypted (AES-256) and sent over the public internet to AWS\n④ On AWS side, Virtual Private Gateway (or TGW) receives and routes to your VPC\n\nWHEN TO USE VPN:\n• Quick setup needed (minutes vs weeks for Direct Connect)\n• Budget-friendly ($36/month)\n• Backup connection for Direct Connect\n• Low-medium bandwidth needs (up to 1.25 Gbps per tunnel)\n• Development/testing environments\n\nSPECS:  Speed: 1.25 Gbps/tunnel  |  Encryption: AES-256  |  2 tunnels (HA)\n        BGP or static routing  |  IKEv1/v2  |  $0.05/hr + data transfer",
			"lineHeight": 1.25,
			"angle": 0,
			"strokeWidth": 2,
			"roughness": 0,
			"opacity": 100,
			"seed": 15829,
			"version": 10,

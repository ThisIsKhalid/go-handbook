okeWidth": 2, "roughness": 0, "opacity": 100, "seed": 14614, "version": 1, "versionNonce": 16540, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "12c2cceb3d1b8455", "type": "ellipse", "x": 3300, "y": 940, "width": 24, "height": 24, "strokeColor": "#F59E0B", "backgroundColor": "#78350F", "fillStyle": "solid", "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 42680, "version": 1, "versionNonce": 77206, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e9800ddec302f899", "type": "text", "x": 3304, "y": 943, "width": 16, "height": 16, "strokeColor": "#FFFFFF", "backgroundColor": "transparent", "fillStyle": "solid", "text": "5", "fontSize": 11, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "5", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 14068, "version": 1, "versionNonce": 53056, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "63dd742a0466a5ab", "type": "text", "x": 3260, "y": 970, "width": 200, "height": 16, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Response returns\nsame path", "fontSize": 10, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Response returns\nsame path", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 30089, "version": 1, "versionNonce": 33301, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "5a34b6e7536bff38", "type": "arrow", "x": 3300, "y": 940, "width": 561, "height": 81, "strokeColor": "#F59E0B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "points": [[0, 0], [-560, 80]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "roundness": {"type": 2}, "angle": 0, "roughness": 0, "opacity": 100, "seed": 46412, "version": 1, "versionNonce": 77471, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "8c2c15270acd81bb", "type": "text", "x": 2440, "y": 1080, "width": 700, "height": 80, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Think of NAT Gateway like a mailroom. Your private\nservers give their mail to the mailroom (NAT), which\nputs ITS return address on the envelope. Responses\ncome back to the mailroom, which delivers them\nto the right server.", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Think of NAT Gateway like a mailroom. Your private\nservers give their mail to the mailroom (NAT), which\nputs ITS return address on the envelope. Responses\ncome back to the mailroom, which delivers them\nto the right server.", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 15910, "version": 1, "versionNonce": 34904, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "30ce1353dbe3bf68", "type": "text", "x": 2440, "y": 1210, "width": 700, "height": 80, "strokeColor": "#CBD5E1", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Key Facts:\n  - $0.045/hr + $0.045/GB data processed\n  - AZ-scoped (lives in ONE Availability Zone)\n  - Up to 45 Gbps bandwidth\n  - Outbound ONLY (private -> internet, NOT internet -> private)", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Key Facts:\n  - $0.045/hr + $0.045/GB data processed\n  - AZ-scoped (lives in ONE Availability Zone)\n  - Up to 45 Gbps bandwidth\n  - Outbound ONLY (private -> internet, NOT internet -> private)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 45021, "version": 1, "versionNonce": 58929, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "f985dcfb226ab8ca", "type": "text", "x": 3430, "y": 1040, "width": 400, "height": 18, "strokeColor": "#F59E0B", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Many-to-1 PAT (Port Address Translation)", "fontSize": 12, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Many-to-1 PAT (Port Address Translation)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 40972, "version": 1, "versionNonce": 61346, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "c51dbd7feb19d773", "type": "rectangle", "x": 3450, "y": 1070, "width": 160, "height": 100, "strokeColor": "#EF4444", "backgroundColor": "#1A0A0A", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 26946, "version": 1, "versionNonce": 99867, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "32cb9c437a67d275", "type": "text", "x": 3460, "y": 1075, "width": 140, "height": 16, "strokeColor": "#EF4444", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Private IPs:", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Private IPs:", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 46263, "version": 1, "versionNonce": 55893, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "d2339d0c345a21c9", "type": "text", "x": 3460, "y": 1095, "width": 140, "height": 60, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "10.0.2.10\n10.0.2.11\n10.0.2.12\n10.0.2.13", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign"
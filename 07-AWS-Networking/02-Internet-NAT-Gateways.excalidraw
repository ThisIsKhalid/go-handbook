-> 54.99.88.77:1024 (PAT)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 59611, "version": 1, "versionNonce": 16827, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "eff066d4d807c5a8", "type": "text", "x": -220, "y": 995, "width": 900, "height": 40, "strokeColor": "#FBBF24", "backgroundColor": "transparent", "fillStyle": "solid", "text": "KEY INSIGHT: Both flows need IGW! NAT GW only handles private-to-public translation.\nIGW is ALWAYS required for traffic between VPC and the internet.", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "KEY INSIGHT: Both flows need IGW! NAT GW only handles private-to-public translation.\nIGW is ALWAYS required for traffic between VPC and the internet.", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 63738, "version": 1, "versionNonce": 72342, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}], "appState": {"gridSize": null, "viewBackgroundColor": "#0F172A"}, "files": {"10bd3a19a8ee4452666e66cd5a6a7e36f2c8fffd": {"mimeType": "image/svg+xml", "id": "10bd3a19a8ee4452666e66cd5a6a7e36f2c8fffd", "dataURL": "data:image/svg+xml;base64,", "created": 1709164800000, "lastRetrieved": 1709164800000}, "7e7bf5d091042c3c405362b4ad922a07990d2ba8": {"mimeType": "image/svg+xml", "id": "7e7bf5d091042c3c405362b4ad922a07990d2ba8", "dataURL": "data:image/svg+xml;base64,", "created": 1709164800000, "lastRetrieved": 1709164800000}, "7a4d83bfae2c407b9d0c5270eb1d1a08527ce9db": {"mimeType": "image/svg+xml", "id": "7a4d83bfae2c407b9d0c5270eb1d1a08527ce9db", "dataURL": "data:image/svg+xml;base64,", "created": 1709164800000, "lastRetrieved": 1709164800000}, "77eb1db6cb81b3cb088d36ab7aae8f230dcfaa28": {"mimeType": "image/svg+xml", "id": "77eb1db6cb81b3cb088d36ab7aae8f230dcfaa28", "dataURL": "data:image/svg+xml;base64,", "create
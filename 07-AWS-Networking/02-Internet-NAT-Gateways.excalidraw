k": null, "locked": false}, {"id": "e676642cf98758ba", "type": "text", "x": 680, "y": 280, "width": 500, "height": 80, "strokeColor": "#CBD5E1", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Key Facts:\n  - FREE (no hourly or data charge)\n  - One per VPC\n  - Horizontally scaled, redundant\n  - Bidirectional (in and out)", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Key Facts:\n  - FREE (no hourly or data charge)\n  - One per VPC\n  - Horizontally scaled, redundant\n  - Bidirectional (in and out)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 71964, "version": 1, "versionNonce": 48906, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "56247e79442e0051", "type": "text", "x": 1280, "y": -50, "width": 280, "height": 70, "strokeColor": "#059669", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Bidirectional traffic:\n  Inbound:  Internet -> IGW -> EC2\n  Outbound: EC2 -> IGW -> Internet", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Bidirectional traffic:\n  Inbound:  Internet -> IGW -> EC2\n  Outbound: EC2 -> IGW -> Internet", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 50790, "version": 1, "versionNonce": 10516, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "b3caa1e471e207b3", "type": "rectangle", "x": 2100, "y": 1065, "width": 200, "height": 70, "strokeColor": "#F59E0B", "backgroundColor": "#78350F", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 70633, "version": 1, "versionNonce": 81882, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "35391c45d0a355ba", "type": "image", "x": 2110, "y": 
, "locked": false}, {"id": "fd657f6c8e4243dc", "type": "rectangle", "x": -300, "y": 700, "width": 1200, "height": 680, "strokeColor": "#F59E0B", "backgroundColor": "#111827", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 49256, "version": 1, "versionNonce": 22137, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "06c07d70d8226ec8", "type": "rectangle", "x": -300, "y": 700, "width": 1200, "height": 34, "strokeColor": "#F59E0B", "backgroundColor": "#F59E0B", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 53264, "version": 1, "versionNonce": 88323, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "d5340055413922ab", "type": "text", "x": -288, "y": 707, "width": 1176, "height": 22, "strokeColor": "#FFFFFF", "backgroundColor": "transparent", "fillStyle": "solid", "text": "NLB \u2014 Network Load Balancer (Layer 4 \u2014 Ultra Fast TCP/UDP)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "NLB \u2014 Network Load Balancer (Layer 4 \u2014 Ultra Fast TCP/UDP)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 90525, "version": 1, "versionNonce": 89711, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "fb2b1afde7c6422b", "type": "arrow", "x": 385, "y": 1100, "width": 516, "height": 61, "strokeColor": "#F59E0B", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 4, "points": [[0, 0], [136, 52], [270, 83], [382, -78], [515, -60]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null, "roundness": {"type": 2}, "angle": 0, "roughness": 2, "opacity": 100, "seed": 63042, "version": 1, "versionNonce": 81183, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "c61d8aeb88604896", "type": "text", "x": -280, "y": 750, "width": 1160, "height": 50, "strokeColor": "#CBD5E1", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Think of NLB like a highway toll booth. It doesn't read your mail \u2014 it just checks\nyour license plate (IP + port) and sends you to the right lane. Extremely fast.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Think of NLB like a highway toll booth. It doesn't read your mail \u2014 it just checks\nyour license plate (IP + port) and sends you to the right lane. Extremely fast.", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 40908, "version": 1, "versionNonce": 63769, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "516a6ebf5b623ee3", "type": "image", "x": -260, "y": 820, "width": 48, "height": 48, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "fileId": "12dea96fec20593566ab75692c9949596833adc9", "scale": [1, 1], "status": "saved", "angle": 0, "roughness": 0, "opacity": 100, "seed": 82160, "version": 1, "versionNonce": 57422, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "250d079a5994a8f1", "type": "text", "x": -270, "y": 872, "width": 68, "height": 18, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "IoT Device\n(TCP)", "fontSize": 10, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "IoT Device\n(TCP)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 79904, "version": 1, "versionNonce": 72492, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "4581bf415e8
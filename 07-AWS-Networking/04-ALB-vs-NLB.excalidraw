"transparent", "fillStyle": "solid", "strokeWidth": 2, "points": [[0, 0], [40, 45]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "roundness": {"type": 2}, "angle": 0, "roughness": 0, "opacity": 100, "seed": 53290, "version": 1, "versionNonce": 46786, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "c0e1c78f56e33471", "type": "rectangle", "x": 1045, "y": 10, "width": 340, "height": 60, "strokeColor": "#7C3AED", "backgroundColor": "#1a0a3e", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 63007, "version": 1, "versionNonce": 33348, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "c34da726e91659c1", "type": "text", "x": 1050, "y": 13, "width": 330, "height": 18, "strokeColor": "#A78BFA", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Target Group 3:  admin.*  \u2192  Lambda", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Target Group 3:  admin.*  \u2192  Lambda", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 96498, "version": 1, "versionNonce": 55290, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "955731e8c779da9d", "type": "image", "x": 1060, "y": 28, "width": 36, "height": 36, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "fileId": "482fbdf656c5a7b9f6d7767c7ead2574b914aaff", "scale": [1, 1], "status": "saved", "angle": 0, "roughness": 0, "opacity": 100, "seed": 54745, "version": 1, "versionNonce": 36387, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "62b69575b744f9d7", "type": "text", "x": 1050, "y": 68, "width": 56, "height": 18, "strokeColor": "#A78BFA", "backgroundColor": "transparent", "fillStyle": "solid", "text": "admin-fn", "fontSize": 10, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "admin-fn", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 96524, "version": 1, "versionNonce": 70022, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "75f4d8578b174de5", "type": "text", "x": 540, "y": 90, "width": 800, "height": 70, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "HOW IT WORKS:\n\u2460 User types api.myapp.com/api/users  \u2461 Route53 resolves to ALB IP  \u2462 ALB reads the URL:\n  \u2022 Path is /api/* \u2192 sends to API target group  \u2022 If it was /web/* \u2192 sends to Web target group\n\u2463 ALB picks a healthy server (round-robin)  \u2464 If a server fails health check \u2192 stops sending traffic", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "HOW IT WORKS:\n\u2460 User types api.myapp.com/api/users  \u2461 Route53 resolves to ALB IP  \u2462 ALB reads the URL:\n  \u2022 Path is /api/* \u2192 sends to API target group  \u2022 If it was /web/* \u2192 sends to Web target group\n\u2463 ALB picks a healthy server (round-robin)  \u2464 If a server fails health check \u2192 stops sending traffic", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 58876, "version": 1, "versionNonce": 68011, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "798da30f72255e8c", "type": "text", "x": 540, "y": 170, "width": 850, "height": 20, "strokeColor": "#34D399", "backgroundColor": "transparent", "fillStyle": "solid", "text": "KEY ALB FEATURES:", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "KEY ALB FEATURES:", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 59244, "version": 1, "versionNonce": 74627, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "ddba63f96906cea7", "type": "text", "x": 540, "y": 195, "width": 1740, "height": 20, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 Layer 7: Understands HTTP, HTTPS, WebSocket, gRPC \u2014 can read URLs, headers, cookies", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 Layer 7: Understands HTTP, HTTPS, WebSocket, gRPC \u2014 can read URLs, headers, cookies", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 86210, "version": 1, "versionNonce": 62960, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "9ab1a5e1c7688cb2", "type": "text", "x": 540, "y": 217, "width": 1740, "height": 20, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 Path Routing: /api/* \u2192 API servers, /images/* \u2192 CDN, /admin/* \u2192 admin panel", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 Path Routing: /api/* \u2192 API servers, /images/* \u2192 CDN, /admin/* \u2192 admin panel", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 25228, "version": 1, "versionNonce": 79374, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "dbc80208505ee08c", "type": "text", "x": 540, "y": 239, "width": 1740, "height": 20, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 Host Routing: api.myapp.com \u2192 API, web.myapp.com \u2192 Frontend (multiple sites on 1 ALB)", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 Host Routing: api.myapp.com \u2192 API, web.myapp.com \u2192 Frontend (multiple sites on 1 ALB)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 43265, "version": 1, "versionNonce": 15438, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "8df4f7f15397e98f", "type": "text", "x": 540, "y": 261, "width": 1740, "height": 20, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 SSL Termination: ALB handles HTTPS certificates (free via ACM) \u2014 your servers use plain HTTP", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 SSL Termination: ALB handles HTTPS certificates (free via ACM) \u2014 your servers use plain HTTP", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 42213, "version": 1, "versionNonce": 75102, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "90405c415c23c57f", "type": "text", "x": 540, "y": 283, "width": 1740, "height": 20, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 Sticky Sessions: If user talks to server-1, keep sending them to server-1 (via cookie)", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 Sticky Sessions: If user talks to server-1, keep sending them to server-1 (via cookie)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 65118, "version": 1, "versionNonce": 15905, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "ab249a161c88bc9b", "type": "text", "x": 540, "y": 305, "width": 1740, "height": 20, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 Built-in Auth: Can add login (Cognito/Google/Facebook) without changing your app code", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 Built-in Auth: Can add login (Cognito/Google/Facebook) without changing your app code", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 41410, "version": 1, "versionNonce": 61153, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "7b3bd179d80eb656", "type": "text", "x": 540, "y": 327, "width": 1740, "height": 20, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 WAF Support: Attach AWS WAF to block SQL injection, XSS, bad bots, rate limiting", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 WAF Support: Attach AWS WAF to block SQL injection, XSS, bad bots, rate limiting", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 15240, "version": 1, "versionNonce": 77832, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "b299d3b6cce9d697", "type": "text", "x": 540, "y": 349, "width": 1740, "height": 20, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "\u2022 Cost: $0.0225/hr ($16.20/month) + $0.008 per LCU-hour (based on connections & data)", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\u2022 Cost: $0.0225/hr ($16.20/month) + $0.008 per LCU-hour (based on connections & data)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 53830, "version": 1, "versionNonce": 64427, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "5dccf22aa52a3fc4", "
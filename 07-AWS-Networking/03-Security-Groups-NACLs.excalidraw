35dc8cac113b9", "type": "rectangle", "x": 140, "y": 2070, "width": 1220, "height": 2, "strokeColor": "#EF4444", "backgroundColor": "#EF4444", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 38557, "version": 1, "versionNonce": 76844, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "c634274f3bd97a9b", "type": "text", "x": 450, "y": 2085, "width": 500, "height": 18, "strokeColor": "#EF4444", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Internet CANNOT reach DB directly \u2014 blocked by SG chaining", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Internet CANNOT reach DB directly \u2014 blocked by SG chaining", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 98291, "version": 1, "versionNonce": 34511, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "12e870dab420a071", "type": "text", "x": 140, "y": 2240, "width": 600, "height": 80, "strokeColor": "#FDE68A", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Each layer only trusts the layer before it.\nThe database only accepts connections from\nthe app servers, NEVER from the internet.\nSGs can reference other SGs as sources!", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Each layer only trusts the layer before it.\nThe database only accepts connections from\nthe app servers, NEVER from the internet.\nSGs can reference other SGs as sources!", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 65374, "version": 1, "versionNonce": 17080, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "4de978db7c0f41d8", "type": "text", "x": 585, "y": 1910, "width": 30, "heigh
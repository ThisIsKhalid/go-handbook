 1, "link": null, "locked": false}, {"id": "12876283017351bc", "type": "text", "x": 1368, "y": -357, "width": 140, "height": 18, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "allowed (default)", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "allowed (default)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 35260, "version": 1, "versionNonce": 34276, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "2d4b927c97c5ce66", "type": "text", "x": 770, "y": -140, "width": 560, "height": 80, "strokeColor": "#CBD5E1", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Think of a Security Group like a bodyguard for each server.\nThe bodyguard has a list of who's allowed in (inbound rules).\nAnyone NOT on the list is turned away.\nThe bodyguard REMEMBERS \u2014 if someone was let in,\ntheir reply is automatically let out (STATEFUL).", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Think of a Security Group like a bodyguard for each server.\nThe bodyguard has a list of who's allowed in (inbound rules).\nAnyone NOT on the list is turned away.\nThe bodyguard REMEMBERS \u2014 if someone was let in,\ntheir reply is automatically let out (STATEFUL).", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 43592, "version": 1, "versionNonce": 59946, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "56bbd6fa99b1de8a", "type": "rectangle", "x": 1420, "y": -560, "width": 620, "height": 30, "strokeColor": "#059669", "backgroundColor": "#064E3B", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 65017, "version": 1, "versionNonce": 11919, "isDeleted": false, "bo
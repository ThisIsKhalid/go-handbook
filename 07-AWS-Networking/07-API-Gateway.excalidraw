n": "left", "verticalAlign": "top", "containerId": null, "originalText": "Backend", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 72984, "version": 1, "versionNonce": 64630, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "1d27ca033e79a134", "type": "text", "x": 2370, "y": 2200, "width": 720, "height": 40, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Best for: HTTP API with external identity providers (Auth0, Okta).\nSimplest auth \u2014 no Lambda needed. Native JWT validation built-in.", "fontSize": 10, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Best for: HTTP API with external identity providers (Auth0, Okta).\nSimplest auth \u2014 no Lambda needed. Native JWT validation built-in.", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 48490, "version": 1, "versionNonce": 72948, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "54ba32b8f2703ae8", "type": "rectangle", "x": 1750, "y": 2290, "width": 1200, "height": 80, "strokeColor": "#7C3AED", "backgroundColor": "#4C1D95", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 83480, "version": 1, "versionNonce": 14888, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "011d7120d2d0ca26", "type": "text", "x": 1770, "y": 2300, "width": 1160, "height": 60, "strokeColor": "#E2E8F0", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Exam Tip: IAM for AWS services, Cognito for web/mobile users,\nLambda Authorizer for custom logic, JWT Authorizer for HTTP API only.\nLambda Authorizer caches policy (TTL up to 1hr) \u2014 saves cost!", "fontSize": 11, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "Exam Tip: IAM for AWS services, Cognito for web/mobile users,\nLambda Authorizer for custom logic, JWT Authorizer for HTTP API only.\nLambda Authorizer caches policy (TTL up to 1hr) \u2014 saves cost!", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 20555, "version": 1, "versionNonce": 74836, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "d830cc163bbc4441", "type": "rectangle", "x": 1600, "y": 2390, "width": 1500, "height": 70, "strokeColor": "#94A3B8", "backgroundColor": "#0F172A", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 83949, "version": 1, "versionNonce": 21938, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "strokeStyle": "dashed"}, {"id": "bb0af249a0a1c912", "type": "text", "x": 1620, "y": 2398, "width": 1460, "height": 50, "strokeColor": "#94A3B8", "backgroundColor": "transparent", "fillStyle": "solid", "text": "REST API supports: IAM, Lambda Authorizer, Cognito\nHTTP API supports: IAM, Lambda Authorizer, JWT Authorizer (no Cognito pools directly)", "fontSize": 11, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top", "containerId": null, "originalText": "REST API supports: IAM, Lambda Authorizer, Cognito\nHTTP API supports: IAM, Lambda Authorizer, JWT Authorizer (no Cognito pools directly)", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 76729, "version": 1, "versionNonce": 98905, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "21b928143068605b", "type": "rectangle", "x": 1600, "y": 2480, "width": 1500, "height": 180, "strokeColor": "#F59E0B", "backgroundColor": "#1A1520", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 25774, "version": 1, "versionNonce": 51
inition but point to\ndifferent backends per stage. Like environment variables!\n\nExample: ${stageVariables.lambdaAlias}\n  dev  stage  \u2192  myFunc:DEV    (Lambda alias)\n  prod stage  \u2192  myFunc:PROD   (Lambda alias)\n\nWorks with: Lambda ARN, HTTP endpoint URL, or any parameter", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Stage variables let you use the SAME API definition but point to\ndifferent backends per stage. Like environment variables!\n\nExample: ${stageVariables.lambdaAlias}\n  dev  stage  \u2192  myFunc:DEV    (Lambda alias)\n  prod stage  \u2192  myFunc:PROD   (Lambda alias)\n\nWorks with: Lambda ARN, HTTP endpoint URL, or any parameter", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 92026, "version": 1, "versionNonce": 53419, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "9bfecc147b9a4838", "type": "rectangle", "x": 90, "y": 2350, "width": 1320, "height": 140, "strokeColor": "#F59E0B", "backgroundColor": "#1A1520", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 51535, "version": 1, "versionNonce": 62682, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "778973a9c85ecd6d", "type": "rectangle", "x": 90, "y": 2350, "width": 1320, "height": 30, "strokeColor": "#F59E0B", "backgroundColor": "#78350F", "fillStyle": "solid", "roundness": {"type": 3}, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 35499, "version": 1, "versionNonce": 80797, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "45f121310eb1c92d", "type": "text", "x": 100, "y": 2355, "width": 1300, "height": 22, "strokeColor": "#E2E8F0", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Canary Deployments \u2014 Safe Rollouts", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Canary Deployments \u2014 Safe Rollouts", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 84446, "version": 1, "versionNonce": 99033, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "3ba754ff793bb42e", "type": "text", "x": 110, "y": 2395, "width": 1280, "height": 80, "strokeColor": "#E2E8F0", "backgroundColor": "transparent", "fillStyle": "solid", "text": "Route a % of traffic to a new deployment while keeping the rest on the old one.\n\nExample: 95% \u2192 current prod deployment, 5% \u2192 new canary deployment\nMonitor CloudWatch metrics \u2192 if OK, promote canary to 100%\nIf errors spike \u2192 roll back instantly by removing the canary", "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Route a % of traffic to a new deployment while keeping the rest on the old one.\n\nExample: 95% \u2192 current prod deployment, 5% \u2192 new canary deployment\nMonitor CloudWatch metrics \u2192 if OK, promote canary to 100%\nIf errors spike \u2192 roll back instantly by removing the canary", "lineHeight": 1.25, "angle": 0, "strokeWidth": 2, "roughness": 0, "opacity": 100, "seed": 21501, "version": 1, "versionNonce": 37528, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "97f9f28925c25280", "type": "arrow", "x": 750, "y": 1735, "width": 1, "height": 116, "strokeColor": "#06B6D4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 4, "points": [[0, 0], [15, 28], [25, 57], [-7, 86], [0, 115]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null, "roundness": {"type": 2}, "angle": 0, "roughness": 2, "opacity": 100, "seed": 14590, "version": 1, "versionNonce": 85631, "isDeleted": false